        Size=UDim2.new(1,0,0,36), Position=UDim2.new(0,0,0,(i-1)*36+8),
        BackgroundColor3=T.SIDEBAR, Text=tab.name,
        TextColor3=T.TEXTDIM, Font=Enum.Font.GothamSemiBold,
        TextSize=11, BorderSizePixel=0, TextXAlignment=Enum.TextXAlignment.Left,
        Parent=sidebar,
