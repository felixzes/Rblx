--  UI HELPERS
-- ════════════════════════════════════════════════════════════════════════════
local function mk(cls, props)
    local i = Instance.new(cls)
    for k, v in pairs(props) do i[k] = v end
    return i
end

local function corner(parent, r)
    mk("UICorner",{CornerRadius=UDim.new(0,r or 8),Parent=parent})
end

local function Lbl(parent, text, pos, size, fs, fc, font, xa, z)
    return mk("TextLabel",{
        Text=text, Position=pos or UDim2.new(0,0,0,0),
        Size=size or UDim2.new(1,0,0,20),
        TextColor3=fc or T.TEXT, BackgroundTransparency=1,
        Font=font or Enum.Font.GothamSemiBold, TextSize=fs or 13,
        TextXAlignment=xa or Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd,
        BorderSizePixel=0, ZIndex=z or 5, Parent=parent,
    })
end

local function Btn(parent, text, pos, size, bg, tc, fs, r, z)
    local b = mk("TextButton",{
        Text=text, Position=pos or UDim2.new(0,0,0,0),
        Size=size or UDim2.new(1,0,0,30),
        BackgroundColor3=bg or T.RED,
        TextColor3=tc or T.TEXT,
        Font=Enum.Font.GothamBold, TextSize=fs or 12,
        BorderSizePixel=0, ZIndex=z or 6,
        AutoButtonColor=false, Parent=parent,
    })
    corner(b, r or 7)
    local orig = bg or T.RED
    b.MouseEnter:Connect(function()
        TweenService:Create(b,TweenInfo.new(0.12),{BackgroundColor3=T.ROWH}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b,TweenInfo.new(0.12),{BackgroundColor3=orig}):Play()
    end)
    return b
end

