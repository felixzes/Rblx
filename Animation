        AutomaticCanvasSize=Enum.AutomaticSize.Y,
        ScrollBarThickness=5,
        ScrollBarImageColor3=T.SEP,
        ZIndex=4,
        Parent=page,
    })
    corner(scroll, 0)

    local layout = mk("UIListLayout",{
        SortOrder=Enum.SortOrder.LayoutOrder,
        Padding=UDim.new(0,3),
        Parent=scroll,
    })
    mk("UIPadding",{
        PaddingTop=UDim.new(0,4), PaddingBottom=UDim.new(0,4),
        PaddingLeft=UDim.new(0,4), PaddingRight=UDim.new(0,4),
        Parent=scroll,
    })

    local ok, err = pcall(function()
        for i, item in ipairs(items) do
            makeItemRow(scroll, item, i)
        end
    end)
    if not ok then
        errLbl.Text = "⚠  List build error: "..(err or "unknown")
        warn("[MM2GodlyHub] List build error:", err)
        return scroll
    end

    -- Search filter
    local function applySearch(query)
        for _, child in pairs(scroll:GetChildren()) do
            if child:IsA("Frame") then
                if query == "" then
                    child.Visible = true
                else
                    -- Find name label (the wider one, starts at UDim2 0,108)
                    local matched = false
                    for _, lbl2 in pairs(child:GetChildren()) do
                        if lbl2:IsA("TextLabel") then
                            if lbl2.Text:lower():find(query, 1, true) then
                                matched = true; break
                            end
                        end
                    end
                    child.Visible = matched
                end
            end
        end
    end

    return scroll, applySearch
end

-- Action bar (Give-All + category shortcuts)
local function makeActionBar(page, label, giveList, giveLabel)
    local bar = mk("Frame",{
        Size=UDim2.new(1,0,0,44),
        Position=UDim2.new(0,0,0,0),
        BackgroundColor3=T.BAR,
        BorderSizePixel=0, ZIndex=5, Parent=page,
    })

    local batchRunning = false
    local giveBtn = mk("TextButton",{
        Size=UDim2.new(0.54,-6,0,30),
        Position=UDim2.new(0,6,0,7),
        BackgroundColor3=T.GOLD,
        Text="⚔  "..label,
        TextColor3=C(10,10,14),
        Font=Enum.Font.GothamBold,
        TextSize=11,
        BorderSizePixel=0, ZIndex=6,
        AutoButtonColor=false,
        Parent=bar,
    })
    corner(giveBtn, 7)
    giveBtn.MouseEnter:Connect(function()
        TweenService:Create(giveBtn,TweenInfo.new(0.1),{BackgroundColor3=T.GOLD2}):Play()
    end)
    giveBtn.MouseLeave:Connect(function()
        TweenService:Create(giveBtn,TweenInfo.new(0.1),{BackgroundColor3=T.GOLD}):Play()
    end)

    giveBtn.MouseButton1Click:Connect(function()
        if batchRunning then return end
        batchRunning = true
        task.spawn(function()
            local total, added, dupes = #giveList, 0, 0
            for i, item in ipairs(giveList) do
                if giveItem(item.name) then
                    added = added + 1
                    if ownedTicks[item.name] then ownedTicks[item.name].Text = "✓" end
                else
                    dupes = dupes + 1
                end
                if i % 10 == 0 then
                    setProgress(i, total, giveLabel.." — "..i.."/"..total)
                    task.wait(0.04)
                end
            end
            setProgress(total, total,
                "✅  Done! "..added.." added, "..dupes.." already owned")
            pcall(function()
                StarterGui:SetCore("SendNotification",{
                    Title="MM2 Godly Hub",
                    Text=added.." Godlies marked — hit Equip on any to wear it",
                    Duration=5,
                })
            end)
            task.wait(0.8)
            batchRunning = false
        end)
    end)

    return bar
end

