--[[
    c00lkidd Walk Cycle — Correct Replication Edition
    This version actually makes other players see the animation.

    Method used:
    1. We still keep the full procedural math (R6 + R15).
    2. Every frame we package the current Motor6D.C0 values.
    3. We fire a RemoteEvent to the server with the table.
    4. A tiny server-side script (included at the bottom) applies the C0s
       so every client receives the correct poses.

    How to use:
    - Put the SERVER part in ServerScriptService (or run it once with an executor that has server access).
    - Run the CLIENT part normally.
    - If the game already has a RemoteEvent you can reuse, just change the name.
]]

-- ═══════════════════════════════════════════════════════════════
--  SERVER SCRIPT (put this in ServerScriptService once)
-- ═══════════════════════════════════════════════════════════════
--[[
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local remote = Instance.new("RemoteEvent")
remote.Name = "CoolkiddWalkReplicate"
remote.Parent = ReplicatedStorage

remote.OnServerEvent:Connect(function(player, data)
    if typeof(data) \~= "table" then return end
    local char = player.Character
    if not char then return end

    for key, cf in pairs(data) do
        if typeof(cf) == "CFrame" then
            local motor = nil
            -- R6
            if key == "neck" then
                motor = char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Neck")
            elseif key == "rS" then
                motor = char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Right Shoulder")
            elseif key == "lS" then
                motor = char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Left Shoulder")
            elseif key == "rH" then
                motor = char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Right Hip")
            elseif key == "lH" then
                motor = char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Left Hip")
            -- R15
            elseif key == "Neck" then
                motor = char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Neck")
            elseif key == "Waist" then
                motor = char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Waist")
            elseif key == "RS" then
                motor = char:FindFirstChild("RightUpperArm") and char.RightUpperArm:FindFirstChild("RightShoulder")
            elseif key == "LS" then
                motor = char:FindFirstChild("LeftUpperArm") and char.LeftUpperArm:FindFirstChild("LeftShoulder")
            elseif key == "RE" then
                motor = char:FindFirstChild("RightLowerArm") and char.RightLowerArm:FindFirstChild("RightElbow")
            elseif key == "LE" then
                motor = char:FindFirstChild("LeftLowerArm") and char.LeftLowerArm:FindFirstChild("LeftElbow")
            elseif key == "RW" then
                motor = char:FindFirstChild("RightHand") and char.RightHand:FindFirstChild("RightWrist")
            elseif key == "LW" then
                motor = char:FindFirstChild("LeftHand") and char.LeftHand:FindFirstChild("LeftWrist")
            elseif key == "RH" then
                motor = char:FindFirstChild("RightUpperLeg") and char.RightUpperLeg:FindFirstChild("RightHip")
            elseif key == "LH" then
                motor = char:FindFirstChild("LeftUpperLeg") and char.LeftUpperLeg:FindFirstChild("LeftHip")
            elseif key == "RK" then
                motor = char:FindFirstChild("RightLowerLeg") and char.RightLowerLeg:FindFirstChild("RightKnee")
            elseif key == "LK" then
                motor = char:FindFirstChild("LeftLowerLeg") and char.LeftLowerLeg:FindFirstChild("LeftKnee")
            elseif key == "RA" then
                motor = char:FindFirstChild("RightFoot") and char.RightFoot:FindFirstChild("RightAnkle")
            elseif key == "LA" then
                motor = char:FindFirstChild("LeftFoot") and char.LeftFoot:FindFirstChild("LeftAnkle")
            end

            if motor then
                pcall(function() motor.C0 = cf end)
            end
        end
    end
end)
]]

-- ═══════════════════════════════════════════════════════════════
--  CLIENT SCRIPT (run this with your executor)
-- ═══════════════════════════════════════════════════════════════

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage= game:GetService("ReplicatedStorage")
local LP               = Players.LocalPlayer

local sin    = math.sin
local cos    = math.cos
local rad    = math.rad
local abs    = math.abs
local clamp  = math.clamp
local pi     = math.pi
local floor  = math.floor

local function ang(x,y,z) return CFrame.Angles(x,y,z) end
local function smoothstep(t) return t*t*(3-2*t) end

-- state
local animEnabled  = false
local animConn     = nil
local walkT        = 0
local idleT        = 0
local idleBlend    = 0
local idlePoseSnap = {}
local defaultC0    = {}
local motors       = {}
local char, hrp, hum, rig
local remote       = nil

-- try to find or create the RemoteEvent
local function getRemote()
    local r = ReplicatedStorage:FindFirstChild("CoolkiddWalkReplicate")
    if r and r:IsA("RemoteEvent") then return r end
    -- if server script is not present we still create a local one (will only work if the game allows it)
    r = Instance.new("RemoteEvent")
    r.Name = "CoolkiddWalkReplicate"
    r.Parent = ReplicatedStorage
    return r
end

-- parameters (same as before)
local W = {
    SPEED        = 2.0 * pi,
    ARM_SWING    = rad(62),
    ARM_SIDE     = rad(12),
    ARM_ROLL     = rad(10),
    LEG_SWING    = rad(56),
    LEG_OUTWARD  = rad(8),
    HIP_BOUNCE   = 0.18,
    TORSO_LEAN   = rad(6),
    HEAD_BOB     = rad(2.5),
    HEAD_SWAY    = rad(2),
    SHOULDER_AMP = rad(62),
    HIP_FLEX     = rad(56),
    KNEE_FOLD    = rad(42),
    ANKLE_ROLL   = rad(14),
    WRIST_FLICK  = rad(10),
    WAIST_TWIST  = rad(9),
    WAIST_LEAN   = rad(6),
    ELBOW_LAG    = 0.52,
}

local function detectRig()
    if not char then return nil end
    if char:FindFirstChild("UpperTorso") then return "R15" end
    if char:FindFirstChild("Torso")      then return "R6"  end
    return nil
end

local function cacheMotors()
    motors = {}; defaultC0 = {}
    rig = detectRig()
    if not rig then return end

    local function reg(partName, motorName, key)
        local p = char:FindFirstChild(partName)
        local m = p and p:FindFirstChild(motorName)
        if m then motors[key]=m; defaultC0[key]=m.C0 end
    end

    if rig == "R6" then
        reg("Torso","Neck",           "neck")
        reg("Torso","Left Shoulder",  "lS")
        reg("Torso","Right Shoulder", "rS")
        reg("Torso","Left Hip",       "lH")
        reg("Torso","Right Hip",      "rH")
    else
        reg("UpperTorso","Neck",           "Neck")
        reg("UpperTorso","Waist",          "Waist")
        reg("LeftUpperArm","LeftShoulder", "LS")
        reg("RightUpperArm","RightShoulder","RS")
        reg("LeftLowerArm","LeftElbow",    "LE")
        reg("RightLowerArm","RightElbow",  "RE")
        reg("LeftHand","LeftWrist",        "LW")
        reg("RightHand","RightWrist",      "RW")
        reg("LeftUpperLeg","LeftHip",      "LH")
        reg("RightUpperLeg","RightHip",    "RH")
        reg("LeftLowerLeg","LeftKnee",     "LK")
        reg("RightLowerLeg","RightKnee",   "RK")
        reg("LeftFoot","LeftAnkle",        "LA")
        reg("RightFoot","RightAnkle",      "RA")
    end
end

local function safeSet(key, newC0)
    if not defaultC0[key] then return end
    local m = motors[key]
    if m and m.Parent then
        pcall(function() m.C0 = newC0 end)
    end
end

local function restoreDefaults()
    for k in pairs(defaultC0) do
        local m = motors[k]
        if m and m.Parent then
            pcall(function() m.C0 = defaultC0[k] end)
        end
    end
end

-- kill default animations
local killClock = 0
local function killDefaultAnims()
    if not char then return end
    local a = char:FindFirstChild("Animate")
    if a then a.Disabled = true end
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
            pcall(function() t:Stop(0) end)
        end
    end
end

-- ── R6 walk ───────────────────────────────────────────────────────────────────
local function r6Walk(t, blend)
    local s = sin(t)
    local c = cos(t)
    local armSec = sin(t*2) * rad(8) * blend
    local legSec = sin(t*2) * rad(6) * blend

    local rLegSwing =  s * W.LEG_SWING * blend
    local lLegSwing = -s * W.LEG_SWING * blend
    local rArmSwing = -s * W.ARM_SWING * blend
    local lArmSwing =  s * W.ARM_SWING * blend
    local rArmSide  =  c * W.ARM_SIDE  * blend
    local lArmSide  = -c * W.ARM_SIDE  * blend
    local rArmRoll  = -s * W.ARM_ROLL  * blend
    local lArmRoll  =  s * W.ARM_ROLL  * blend
    local rHipY = math.max(0,  sin(t)) * W.HIP_BOUNCE * blend
    local lHipY = math.max(0, -sin(t)) * W.HIP_BOUNCE * blend

    safeSet("rS", defaultC0["rS"] * ang(W.TORSO_LEAN + rArmSwing + armSec, 0, rArmRoll) * ang(0, 0, rArmSide))
    safeSet("lS", defaultC0["lS"] * ang(W.TORSO_LEAN + lArmSwing + armSec, 0, lArmRoll) * ang(0, 0, lArmSide))
    safeSet("rH", defaultC0["rH"] * CFrame.new(0, rHipY, 0) * ang(rLegSwing + legSec, 0, 0) * ang(0, W.LEG_OUTWARD * blend, 0))
    safeSet("lH", defaultC0["lH"] * CFrame.new(0, lHipY, 0) * ang(lLegSwing + legSec, 0, 0) * ang(0, -W.LEG_OUTWARD * blend, 0))
    safeSet("neck", defaultC0["neck"] * ang(-rad(4) + sin(t) * W.HEAD_BOB * blend, s * W.HEAD_SWAY * blend, 0))
end

-- ── ankle + knee helpers ──────────────────────────────────────────────────────
local function ankleAngle(t, isRight)
    local phase = isRight and t or (t + pi)
    local n = (sin(phase) + 1) * 0.5
    if n < 0.35 then
        return -W.ANKLE_ROLL * (n / 0.35)
    elseif n < 0.65 then
        local k = (n-0.35)/0.30
        return -W.ANKLE_ROLL + (W.ANKLE_ROLL + rad(8))*k
    else
        return rad(8) * (1 - (n-0.65)/0.35)
    end
end

local function kneeBend(t, isRight)
    local phase = isRight and t or (t + pi)
    local base    = (1 - cos(phase)) * 0.5
    local recover = math.max(0, -sin(phase))
    return (base*0.25 + recover*0.75) * W.KNEE_FOLD
end

-- ── R15 walk ──────────────────────────────────────────────────────────────────
local function r15Walk(t, blend)
    local s    = sin(t)
    local tLag = t - W.ELBOW_LAG
    local sLag = sin(tLag)
    local armSec = sin(t*2) * rad(6) * blend

    safeSet("Waist", (defaultC0["Waist"] or CFrame.new()) * ang(W.WAIST_LEAN, s*W.WAIST_TWIST*blend, sin(t*2)*rad(2)*blend))
    safeSet("Neck",  (defaultC0["Neck"]  or CFrame.new()) * ang(-rad(4)+sin(t)*W.HEAD_BOB*blend, s*W.HEAD_SWAY*blend, 0))

    safeSet("RS", (defaultC0["RS"] or CFrame.new()) * ang(-s*W.SHOULDER_AMP*blend+W.WAIST_LEAN+armSec, 0, rad(10)*blend))
    local rE = clamp((1-cos(-sLag*W.SHOULDER_AMP*blend))*rad(42)*blend, 0, rad(100))
    safeSet("RE", (defaultC0["RE"] or CFrame.new()) * ang(rE, 0, 0))
    safeSet("RW", (defaultC0["RW"] or CFrame.new()) * ang(-s*W.WRIST_FLICK*blend, 0, 0))

    safeSet("LS", (defaultC0["LS"] or CFrame.new()) * ang(s*W.SHOULDER_AMP*blend+W.WAIST_LEAN+armSec, 0, -rad(10)*blend))
    local lE = clamp((1-cos(sLag*W.SHOULDER_AMP*blend))*rad(42)*blend, 0, rad(100))
    safeSet("LE", (defaultC0["LE"] or CFrame.new()) * ang(lE, 0, 0))
    safeSet("LW", (defaultC0["LW"] or CFrame.new()) * ang(s*W.WRIST_FLICK*blend, 0, 0))

    local rHipY = math.max(0,  sin(t)) * W.HIP_BOUNCE * blend
    local lHipY = math.max(0, -sin(t)) * W.HIP_BOUNCE * blend

    safeSet("RH", (defaultC0["RH"] or CFrame.new()) * CFrame.new(0, rHipY, 0) * ang(s*W.HIP_FLEX*blend, rad(5)*blend, 0))
    safeSet("RK", (defaultC0["RK"] or CFrame.new()) * ang(-kneeBend(t,true)*blend, 0, 0))
    safeSet("RA", (defaultC0["RA"] or CFrame.new()) * ang(ankleAngle(t,true)*blend, rad(4)*blend, 0))

    safeSet("LH", (defaultC0["LH"] or CFrame.new()) * CFrame.new(0, lHipY, 0) * ang(-s*W.HIP_FLEX*blend, -rad(5)*blend, 0))
    safeSet("LK", (defaultC0["LK"] or CFrame.new()) * ang(-kneeBend(t,false)*blend, 0, 0))
    safeSet("LA", (defaultC0["LA"] or CFrame.new()) * ang(ankleAngle(t,false)*blend, -rad(4)*blend, 0))
end

-- ── idle ──────────────────────────────────────────────────────────────────────
local function applyIdle(t, blend)
    local rock = sin(t*1.4)*rad(2.5)
    local bob  = sin(t*2.8)*rad(1.0)
    local sway = sin(t*0.9)*rad(2.0)

    local function lrp(key, idleC0)
        local snap = idlePoseSnap[key] or defaultC0[key]
        if not snap then return idleC0 end
        return snap:Lerp(idleC0, smoothstep(blend))
    end

    if rig == "R6" then
        if defaultC0["neck"] then safeSet("neck", lrp("neck", defaultC0["neck"]*ang(-rad(4)+bob, sway*0.4, rock))) end
        if defaultC0["rS"]   then safeSet("rS",   lrp("rS",   defaultC0["rS"]*ang(rad(5)+abs(sin(t*1.8))*rad(3),0,rad(3)))) end
        if defaultC0["lS"]   then safeSet("lS",   lrp("lS",   defaultC0["lS"]*ang(rad(5)+abs(sin(t*1.8))*rad(3),0,-rad(3)))) end
        if defaultC0["rH"]   then safeSet("rH",   lrp("rH",   defaultC0["rH"]*ang(rad(2),W.LEG_OUTWARD*0.5,0))) end
        if defaultC0["lH"]   then safeSet("lH",   lrp("lH",   defaultC0["lH"]*ang(rad(2),-W.LEG_OUTWARD*0.5,0))) end
    else
        if defaultC0["Waist"] then safeSet("Waist", lrp("Waist", (defaultC0["Waist"] or CFrame.new())*ang(rad(4)+rock*0.3,rock,0))) end
        if defaultC0["Neck"]  then safeSet("Neck",  lrp("Neck",  (defaultC0["Neck"]  or CFrame.new())*ang(-rad(4)+bob,sway*0.3,rock*0.4))) end
        if defaultC0["RS"] then safeSet("RS", lrp("RS", defaultC0["RS"]*ang(rad(4),0,rad(8)))) end
        if defaultC0["LS"] then safeSet("LS", lrp("LS", defaultC0["LS"]*ang(rad(4),0,-rad(8)))) end
        if defaultC0["RE"] then safeSet("RE", lrp("RE", defaultC0["RE"]*ang(rad(10),0,0))) end
        if defaultC0["LE"] then safeSet("LE", lrp("LE", defaultC0["LE"]*ang(rad(10),0,0))) end
        if defaultC0["RW"] then safeSet("RW", lrp("RW", defaultC0["RW"])) end
        if defaultC0["LW"] then safeSet("LW", lrp("LW", defaultC0["LW"])) end
        if defaultC0["RH"] then safeSet("RH", lrp("RH", defaultC0["RH"]*ang(rad(2),rad(4),0))) end
        if defaultC0["LH"] then safeSet("LH", lrp("LH", defaultC0["LH"]*ang(rad(2),-rad(4),0))) end
        if defaultC0["RK"] then safeSet("RK", lrp("RK", defaultC0["RK"])) end
        if defaultC0["LK"] then safeSet("LK", lrp("LK", defaultC0["LK"])) end
        if defaultC0["RA"] then safeSet("RA", lrp("RA", defaultC0["RA"])) end
        if defaultC0["LA"] then safeSet("LA", lrp("LA", defaultC0["LA"])) end
    end
end

local function snapshotPose()
    idlePoseSnap = {}
    for k, m in pairs(motors) do
        if m and m.Parent then idlePoseSnap[k] = m.C0 end
    end
end

-- ── send current pose to server every frame ───────────────────────────────────
local function replicatePose()
    if not remote then return end
    local data = {}
    for k, m in pairs(motors) do
        if m and m.Parent then
            data[k] = m.C0
        end
    end
    pcall(function()
        remote:FireServer(data)
    end)
end

-- ── main loop ─────────────────────────────────────────────────────────────────
local prevMoving = false

local function startAnim()
    if animConn then animConn:Disconnect(); animConn = nil end
    killClock  = 0
    prevMoving = false
    idleBlend  = 0
    remote = getRemote()

    animConn = RunService.Heartbeat:Connect(function(dt)
        if not animEnabled or not char or not hrp then return end

        killClock = killClock + dt
        if killClock >= 0.4 then
            killClock = 0
            killDefaultAnims()
        end

        local speed   = hrp.AssemblyLinearVelocity.Magnitude
        local moving  = speed > 0.5
        local velScale = clamp(speed / 16, 0.5, 2.2)

        if moving then
            if not prevMoving then idleBlend = 0 end
            prevMoving = true
            idleBlend  = 0
            walkT = walkT + dt * W.SPEED * velScale
            idleT = walkT
            local blend = smoothstep(clamp(speed / 6, 0, 1))
            if rig == "R6" then r6Walk(walkT, blend)
            else r15Walk(walkT, blend) end
        else
            if prevMoving then snapshotPose(); idleBlend = 0 end
            prevMoving = false
            idleT     = idleT + dt * 1.4
            idleBlend = clamp(idleBlend + dt / 0.3, 0, 1)
            applyIdle(idleT, idleBlend)
        end

        -- THIS is what actually makes other players see it
        replicatePose()
    end)
end

local function stopAnim()
    if animConn then animConn:Disconnect(); animConn = nil end
    restoreDefaults()
    walkT = 0; idleT = 0; idleBlend = 0
    prevMoving = false; idlePoseSnap = {}
end

-- ── character init ────────────────────────────────────────────────────────────
local function initChar(c)
    stopAnim()
    char = c
    hrp  = c:WaitForChild("HumanoidRootPart")
    hum  = c:WaitForChild("Humanoid")
    task.wait(0.5)
    cacheMotors()
    killDefaultAnims()
    if animEnabled then startAnim() end
end

LP.CharacterRemoving:Connect(function()
    stopAnim()
    motors = {}; defaultC0 = {}
    char = nil; hrp = nil; hum = nil
end)

LP.CharacterAdded:Connect(function(c)
    task.wait(0.1)
    initChar(c)
end)

if LP.Character then initChar(LP.Character) end

