    TRAIL_MODE = not TRAIL_MODE

    if TRAIL_MODE then
        -- ── Entering trail mode ───────────────────────────────────────────────
        trailBtn.Text              = "🐍  Snake Trail: ON"
        trailBtn.BackgroundColor3  = C(0,140,70)
        trailStatusLbl.Text        = "Status  : Trail Active"
        trailStatusLbl.TextColor3  = C(80,255,120)

        -- Kill any active individual sword drags
        for _, sw in ipairs(swords) do
            sw.fingerActive = false; sw.fingerTouch = nil
        end
        for _, fd in ipairs(fingerDots) do fd.Visible = false end
        touchToSword = {}

        -- Seed history at current Sword 1 position (no jumpstart snake)
        local initPos = swords[1] and swords[1].centerPos
            or (humanoidRootPart and humanoidRootPart.Position or Vector3.new())
        initHistory(initPos)

        -- Reset joystick
        sjActive = false; sjDelta = Vector2.new()
        -- JoyKnob will be referenced below — reset via stored ref
    else
        -- ── Leaving trail mode ────────────────────────────────────────────────
        TRAIL_MODE = false
