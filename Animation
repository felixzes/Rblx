-- ─── Auto Pet Glitch ──────────────────────────────────────────────────────────
--[[
    Pet Glitch Mechanic (wiki-verified):
    Formula: (rebirths + 20) × rock_value = XP per punch
    Must equal cumulative XP for levels 1–N of the pet.
    Pet must be Level 1 with 0 XP before starting.
    Muscle King Rock: punch OUTSIDE the ring!
    
    2026 patch note: Pure XP manipulation via remote is patched.
    Current method: firetouchinterest on rock while pet is equipped.
    Old method: direct XP remote fire (patched in late 2025).
]]

local glitchConn
local glitchActive    = false
local currentGlitchPet= nil

local function findBestGlitchPet()
    local pets = Player:FindFirstChild("Pets")
    if not pets then return nil end
    local priority = {"Unique","Epic","Rare","Uncommon","Basic"}
    for _, rarity in ipairs(priority) do
        for _, pet in pairs(pets:GetChildren()) do
            if pet:FindFirstChild("Rarity") and pet.Rarity.Value == rarity then
                local lvl = pet:FindFirstChild("Level")
                local xp  = pet:FindFirstChild("XP") or pet:FindFirstChild("Exp")
                if lvl and lvl.Value <= 1 and (not xp or xp.Value == 0) then
                    return pet
                end
            end
        end
    end
    return nil
end

local function equipPetObj(pet)
    if not pet then return end
    local equipRemote = Remotes and Remotes:FindFirstChild("EquipPet")
    if equipRemote then
        pcall(function() equipRemote:FireServer(pet) end)
    end
end

local function findRockPart(rockNames)
    for _, name in ipairs(rockNames) do
        local obj = Workspace:FindFirstChild(name, true)
        if obj and obj:IsA("BasePart") then return obj end
    end
    -- Scan all baseParts for rock-like names
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("rock") or n:find("punch") or n:find("muscle") then
                return obj
            end
        end
    end
    return nil
end

local CURRENT_ROCKS = {"MuscleKingRock","MuscleRock","KingRock","PunchRock","Rock"}
local OLD_ROCKS     = {"GreenRock","JungleRock","BeachRock","SmallRock"}

local function petGlitchLoop()
    local currentRebirths = getStat("Rebirths") or 0
    if not isGlitchable(currentRebirths) then
        -- Warn in status
        return false
    end

    local pet = CFG.SelectedPetName == "Auto (Best)" and findBestGlitchPet() or nil
    if not pet then return false end

    equipPetObj(pet)
    currentGlitchPet = pet
    task.wait(0.5)

    -- Teleport to rock (outside ring for Muscle King)
    local hrp = getHRP(); if not hrp then return false end
    hrp.CFrame = TELEPORTS["Muscle King Rock"]
    task.wait(0.5)

    -- Find rock
    local rockList = CFG.UseOldMethod and OLD_ROCKS or CURRENT_ROCKS
    local rock     = findRockPart(rockList)
    if not rock then return false end

    -- Punch rock loop
    local punchCount = 0
    local lastXP     = 0

    while CFG.AutoPetGlitch and glitchActive do
        -- XP lock check — stop if pet about to level 20
        if pet:FindFirstChild("Level") and pet.Level.Value >= 19 then
            -- Pet maxed or about to max — stop glitch to preserve
            if CFG.PetLevelLock then
                break
            end
        end

        pcall(function()
            firetouchinterest(hrp, rock, 0)
            task.wait(0.02)
            firetouchinterest(hrp, rock, 1)
        end)

        punchCount = punchCount + 1
        local currentXP = (pet:FindFirstChild("XP") or pet:FindFirstChild("Exp"))
        if currentXP then
            local xpGain = currentXP.Value - lastXP
            if xpGain > 0 then
                glitchStats = glitchStats + xpGain -- approximate
                glitchXP    = currentXP.Value
            end
            lastXP = currentXP.Value
        end

        task.wait(0.05)
    end

    return true
end

glitchConn = RunService.Heartbeat:Connect(function()
    if not CFG.AutoPetGlitch or glitchActive then return end
    glitchActive = true
    task.spawn(function()
        petGlitchLoop()
        task.wait(1)
        glitchActive = false
    end)
end)

-- ─── Auto Set Size ────────────────────────────────────────────────────────────
local SIZE_PRESETS = {
    Normal  = 1.0,
    Big     = 1.8,
    Huge    = 3.2,
    Max     = 6.0,
}

local function applySize(preset)
    local scale = SIZE_PRESETS[preset] or 1.0
    local hum   = getHum(); if not hum then return end
    -- BodyDepthScale, BodyHeightScale, BodyWidthScale, HeadScale
    for _, desc in pairs(hum:GetDescendants()) do
        if desc:IsA("NumberValue") then
            if desc.Name:find("Scale") then
                desc.Value = scale
            end
        end
    end
    -- Also try BodyTypeScale for bigger effect
    local bts = hum:FindFirstChild("BodyTypeScale")
    if bts then bts.Value = math.min(scale, 1.0) end
    local ws  = hum:FindFirstChild("BodyWidthScale")
    if ws then ws.Value = scale end
    local hs  = hum:FindFirstChild("BodyHeightScale")
    if hs then hs.Value = scale end
    -- Try via SetAttribute or remote if available
    local sizeRemote = Remotes and Remotes:FindFirstChild("SetSize")
    if sizeRemote then
        pcall(function() sizeRemote:FireServer(scale) end)
    end
end

