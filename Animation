local TARGETS = {}

local function push(x,y,z) table.insert(TARGETS,{x=x,y=y,z=z}) end

local function fullRing(cx,cy,cz,rx,rz,n)
    for i=0,n-1 do
        local a=2*math.pi*i/n
        push(cx+rx*math.cos(a), cy, cz+rz*math.sin(a))
    end
end

local function bladeHW(y)
    if y<=-14 then return 2.0 end
    if y>=62  then return 0.0 end
    local t=(y+14)/76
    return 2.0*(1-t)^1.3
end

local function bladeHD(y)
    if y<=-14 then return 0.55 end
    if y>=62  then return 0.0  end
    local t=(y+14)/76
    return 0.55*(1-t)^1.1
end

