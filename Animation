local function mkLbl(txt,y,col,sz)
    local L=Instance.new("TextLabel")
    L.Size=UDim2.new(1,-16,0,13); L.Position=UDim2.new(0,8,0,y)
    L.BackgroundTransparency=1; L.Text=txt
    L.TextColor3=col or Color3.fromRGB(180,80,80); L.TextSize=sz or 10
    L.Font=Enum.Font.Gotham; L.TextXAlignment=Enum.TextXAlignment.Left
    L.ZIndex=3; L.Parent=panel; return L
end
local function mkBtn(txt,y,h,col)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(1,-16,0,h or 34); b.Position=UDim2.new(0,8,0,y)
    b.BackgroundColor3=col or Color3.fromRGB(120,0,0); b.BorderSizePixel=0
    b.Text=txt; b.TextColor3=Color3.fromRGB(255,255,255)
    b.TextSize=13; b.Font=Enum.Font.GothamBold; b.ZIndex=3; b.Parent=panel
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,10)
    return b
end
local function mkStepper(y,labelTxt,getV,onDec,onInc)
    mkLbl(labelTxt,y)
    local function sb(txt,xScale)
        local b=Instance.new("TextButton")
        b.Size=UDim2.new(0.22,0,0,26); b.Position=UDim2.new(xScale,0,0,y+14)
        b.BackgroundColor3=Color3.fromRGB(60,10,10); b.BorderSizePixel=0
        b.Text=txt; b.TextColor3=Color3.fromRGB(255,200,200)
        b.TextSize=14; b.Font=Enum.Font.GothamBold; b.ZIndex=3; b.Parent=panel
        Instance.new("UICorner",b).CornerRadius=UDim.new(0,7)
        return b
    end
    local dec=sb("-",0.08)
    local disp=Instance.new("TextLabel")
    disp.Size=UDim2.new(0.42,0,0,26); disp.Position=UDim2.new(0.3,0,0,y+14)
    disp.BackgroundColor3=Color3.fromRGB(30,4,4); disp.BorderSizePixel=0
    disp.Text=getV(); disp.TextColor3=Color3.fromRGB(255,160,160)
    disp.TextSize=12; disp.Font=Enum.Font.GothamBold; disp.ZIndex=3; disp.Parent=panel
    Instance.new("UICorner",disp).CornerRadius=UDim.new(0,7)
    local inc=sb("+",0.72)
    dec.MouseButton1Click:Connect(function() onDec(); disp.Text=getV() end)
    inc.MouseButton1Click:Connect(function() onInc(); disp.Text=getV() end)
    return disp
end

