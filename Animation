-- ─── Toggle switch ────────────────────────────────────────────────────────────
local function createToggle(parent, yPos, labelText, cfgKey, onChange)
    local row = inst("Frame",{
        Size=UDim2.new(1,-16,0,28), Position=UDim2.new(0,8,0,yPos),
        BackgroundTransparency=1, Parent=parent,
    })
    label(row, labelText, UDim2.new(0,0,0,4), UDim2.new(1,-56,1,0), 12, T.TEXT)
    local track = inst("Frame",{
        Size=UDim2.new(0,44,0,22), Position=UDim2.new(1,-44,0.5,-11),
        BackgroundColor3=CFG[cfgKey] and T.TOGGLE_ON or T.TOGGLE_OFF,
        BorderSizePixel=0, Parent=row,
    })
    corner(track, 11)
    local thumb = inst("Frame",{
        Size=UDim2.new(0,18,0,18), Position=CFG[cfgKey] and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9),
        BackgroundColor3=C(240,240,240), BorderSizePixel=0, Parent=track,
    })
    corner(thumb, 9)

    local function setState(state)
        CFG[cfgKey] = state
        local tw = TweenService:Create(track, TweenInfo.new(0.15),
            {BackgroundColor3=state and T.TOGGLE_ON or T.TOGGLE_OFF})
        local tp = TweenService:Create(thumb, TweenInfo.new(0.15),
            {Position=state and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9)})
        tw:Play(); tp:Play()
        if onChange then onChange(state) end
        saveConfig()
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            setState(not CFG[cfgKey])
        end
    end)

    -- Return setter for programmatic updates
    return setState
end

-- ─── Slider ──────────────────────────────────────────────────────────────────
local function createSlider(parent, yPos, labelText, cfgKey, minV, maxV, onChange)
    local row = inst("Frame",{
        Size=UDim2.new(1,-16,0,50), Position=UDim2.new(0,8,0,yPos),
        BackgroundTransparency=1, Parent=parent,
    })
    local lbl = label(row, labelText.." : "..tostring(CFG[cfgKey]),
        UDim2.new(0,0,0,0), UDim2.new(1,0,0,18), 12, T.TEXT)
    local track = inst("Frame",{
        Size=UDim2.new(1,0,0,6), Position=UDim2.new(0,0,0,26),
        BackgroundColor3=T.BG3, BorderSizePixel=0, Parent=row,
    })
    corner(track, 3)
    local pct    = (CFG[cfgKey] - minV) / (maxV - minV)
    local fill   = inst("Frame",{
        Size=UDim2.new(pct,0,1,0), BackgroundColor3=T.ACCENT,
        BorderSizePixel=0, Parent=track,
    })
    corner(fill, 3)
    local thumb  = inst("Frame",{
        Size=UDim2.new(0,14,0,14), Position=UDim2.new(pct,-7,-0.5,-1),
        BackgroundColor3=T.ACCENT2, BorderSizePixel=0, Parent=track,
    })
    corner(thumb, 7)

    local dragging = false
    thumb.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dragging=true end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dragging=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if not dragging then return end
        local abs = track.AbsolutePosition
        local sz  = track.AbsoluteSize
        local relX= math.clamp((i.Position.X - abs.X) / sz.X, 0, 1)
        local val = math.floor(minV + relX * (maxV - minV))
        CFG[cfgKey] = val
        fill.Size   = UDim2.new(relX, 0, 1, 0)
        thumb.Position = UDim2.new(relX, -7, -0.5, -1)
        lbl.Text = labelText.." : "..tostring(val)
        if onChange then onChange(val) end
        saveConfig()
    end)
end

