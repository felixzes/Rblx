local function switchTab(key)
    if activeKey == key then return end
    activeKey = key
    for _, tab in ipairs(TABS) do
        local refs = tabBtnRefs[tab.key]
        local on   = (tab.key == key)
        refs.btn.TextColor3       = on and T.GOLD or T.DIM
        refs.btn.BackgroundColor3 = on and T.TABSEL or T.TAB
        refs.ul.Visible           = on
        pageFrames[tab.key].Visible = on
    end
end

-- Wire tab buttons now that pageFrames exist
for _, tab in ipairs(TABS) do
    tabBtnRefs[tab.key].btn.MouseButton1Click:Connect(function()
        switchTab(tab.key)
    end)
end

