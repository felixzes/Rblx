local function findWeaponModel(name)
    local base = name:gsub("^Chroma ", "")
    local function tryFind(folder)
        if not folder then return nil end
        for _, c in pairs(folder:GetChildren()) do
            if c.Name:lower() == name:lower() or c.Name:lower() == base:lower() then
                return c
            end
        end
        return nil
    end
    local candidates = {"Knifes","Guns","Weapons","Items","Tools"}
    for _, cn in ipairs(candidates) do
        local f = ReplicatedStorage:FindFirstChild(cn)
        local r = tryFind(f); if r then return r end
        local w = Workspace:FindFirstChild(cn)
        r = tryFind(w); if r then return r end
    end
    for _, d in pairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("Tool") and (d.Name:lower()==name:lower() or d.Name:lower()==base:lower()) then
            return d end
    end
    return nil
end

local chromaHue = 0
RunService.Heartbeat:Connect(function(dt)
    chromaHue = (chromaHue + dt * 0.4) % 1
    local char = Player.Character; if not char then return end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:GetAttribute("IsChroma") then
            for _, p in pairs(tool:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.Color = Color3.fromHSV(chromaHue, 0.8, 1)
                end
            end
        end
    end
end)

local function equipWeapon(name, cat)
    local char = Player.Character
    if not char then return false, "No character" end
    local model = findWeaponModel(name)
    if not model then return false, "Model not in game storage: "..name end
    local clone = model:Clone()
    if cat:find("Chroma") then clone:SetAttribute("IsChroma", true) end
    for _, t in pairs(char:GetChildren()) do if t:IsA("Tool") then t:Destroy() end end
    clone.Parent = char
    return true, "Equipped: "..name
end

local function giveItem(name)
    if OWNED[name] then return false end
    OWNED[name] = true; return true
end

