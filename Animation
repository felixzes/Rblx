        -- Cancel return, snap swords to formation immediately
        cancelReturn()
        for i, sw in ipairs(swords) do
            if sw.enabled then
                sw.centerPos       = getFollowPos(i)
                sw.anchor.Position = sw.centerPos
            end
        end
    end
end)

