-- ─── Auto Punch ───────────────────────────────────────────────────────────────
local punchConn
local function startAutoPunch()
    if punchConn then punchConn:Disconnect() end
    punchConn = RunService.Heartbeat:Connect(function()
        if not CFG.AutoPunch then return end
        local toolName = CFG.BestTool and getBestTool(PUNCH_TOOLS) or "Punch"
        equipTool(toolName)
        local char = getChar(); if not char then return end
        local tool = char:FindFirstChild(toolName)
        if not tool then return end
        if lockedPos and CFG.LockPosition then
            local hrp = getHRP()
            if hrp then hrp.CFrame = lockedPos end
        end
        local handle = tool:FindFirstChild("Handle")
        if handle then
            local hitbox = Workspace:FindFirstChild("PunchingRock")
                or Workspace:FindFirstChild("GreenRock")
                or Workspace:FindFirstChild("Rock")
            if hitbox then
                pcall(function()
                    firetouchinterest(handle, hitbox, 0)
                    task.wait(1 / math.max(CFG.PunchSpeed, 1))
                    firetouchinterest(handle, hitbox, 1)
                end)
            else
                pcall(function() tool:Activate() end)
                task.wait(1 / math.max(CFG.PunchSpeed, 1))
            end
        end
    end)
end

-- ─── Auto Training (generic tool activator) ──────────────────────────────────
local trainConns = {}
local function startTraining(key, toolNames, interval)
    if trainConns[key] then trainConns[key]:Disconnect() end
    trainConns[key] = RunService.Heartbeat:Connect(function()
        if not CFG[key] then return end
        local toolName = toolNames[1]
        equipTool(toolName)
        local char = getChar(); if not char then return end
        local tool = char:FindFirstChild(toolName)
        if not tool then return end
        pcall(function() tool:Activate() end)
        -- Find nearest training pad and firetouchinterest
        local hrp = getHRP(); if not hrp then return end
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (
                obj.Name == "TrainingPad" or obj.Name == "PushupPad" or
                obj.Name == "SitupPad"   or obj.Name == "WeightPad" or
                obj.Name == "HandstandPad") then
                local dist = (obj.Position - hrp.Position).Magnitude
                if dist < 25 then
                    pcall(function()
                        firetouchinterest(hrp, obj, 0)
                        firetouchinterest(hrp, obj, 1)
                    end)
                end
            end
        end
        task.wait(interval or (1 / math.max(CFG.TrainSpeed, 1)))
    end)
end

