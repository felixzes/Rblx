-- ─── Batch give function ──────────────────────────────────────────────────────
local batchRunning = false

local function batchGive(items, statusPrefix)
    if batchRunning then return end
    batchRunning = true
    task.spawn(function()
        local total  = #items
        local added  = 0
        local dupes  = 0

        for i, item in ipairs(items) do
            if giveItem(item.name) then
                added = added + 1
                if ownedLabels[item.name] then ownedLabels[item.name].Text="✓" end
            else
                dupes = dupes + 1
            end
            setProgress(i, total, statusPrefix.." — "..i.."/"..total)
            task.wait(0.04)   -- small batch delay, no lag spikes
        end

        setProgress(total,total,
            "✅  Done! "..added.." added, "..dupes.." already owned")

        -- Notify
        pcall(function()
            StarterGui:SetCore("SendNotification",{
                Title="MM2 Godly Hub",
                Text=added.." Godlies added — equip any to make others see it",
                Duration=6,
            })
        end)

        task.wait(1)
        batchRunning=false
    end)
end

