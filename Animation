local function inst(cls, props)
    local i = Instance.new(cls)
    for k, v in pairs(props) do i[k] = v end
    return i
end

local function corner(parent, r)
    inst("UICorner",{CornerRadius=UDim.new(0,r or 8),Parent=parent})
end

local function pad(parent, t, r, b, l)
    inst("UIPadding",{
        PaddingTop=UDim.new(0,t or 6),PaddingRight=UDim.new(0,r or 6),
        PaddingBottom=UDim.new(0,b or 6),PaddingLeft=UDim.new(0,l or 6),
        Parent=parent
    })
end

local function lbl(parent,text,pos,size,fs,fc,font,xa,zidx)
    return inst("TextLabel",{
        Text=text,Position=pos or UDim2.new(0,0,0,0),
        Size=size or UDim2.new(1,0,0,20),
        TextColor3=fc or T.TEXT,BackgroundTransparency=1,
        Font=font or Enum.Font.GothamSemiBold,TextSize=fs or 13,
        TextXAlignment=xa or Enum.TextXAlignment.Left,
        BorderSizePixel=0,ZIndex=zidx or 5,Parent=parent,
        TextTruncate=Enum.TextTruncate.AtEnd,
    })
end

local function btn(parent,text,pos,size,bg,tc,fs,r,z)
    local B = inst("TextButton",{
        Text=text,Position=pos or UDim2.new(0,0,0,0),
        Size=size or UDim2.new(1,0,0,30),
        BackgroundColor3=bg or T.ACCENT,
        TextColor3=tc or T.TEXT,
        Font=Enum.Font.GothamBold,TextSize=fs or 13,
        BorderSizePixel=0,ZIndex=z or 6,Parent=parent,
        AutoButtonColor=false,
    })
    corner(B,r or 7)
    B.MouseEnter:Connect(function()
        TweenService:Create(B,TweenInfo.new(0.1),{BackgroundColor3=T.ACCENT2}):Play()
    end)
    B.MouseLeave:Connect(function()
        TweenService:Create(B,TweenInfo.new(0.1),{BackgroundColor3=bg or T.ACCENT}):Play()
    end)
    return B
end

