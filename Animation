-- MM2 stores weapon tools in several possible paths
local function findWeaponModel(name)
    -- Strip "Chroma " prefix for model search (model exists without prefix)
    local searchName = name:gsub("^Chroma ", "")

    local searchPaths = {
        -- Primary: MM2 ReplicatedStorage folders
        ReplicatedStorage:FindFirstChild("Knifes"),
        ReplicatedStorage:FindFirstChild("Guns"),
        ReplicatedStorage:FindFirstChild("Weapons"),
        ReplicatedStorage:FindFirstChild("Items"),
        ReplicatedStorage:FindFirstChild("Tools"),
        -- Workspace lobby/game folders
        Workspace:FindFirstChild("Knifes"),
        Workspace:FindFirstChild("Guns"),
        Workspace:FindFirstChild("Weapons"),
        -- Direct children with prefix
        ReplicatedStorage,
    }

    for _, folder in pairs(searchPaths) do
        if folder then
            -- Exact match
            local m = folder:FindFirstChild(name)
            if m then return m end
            -- Without "Chroma " prefix
            m = folder:FindFirstChild(searchName)
            if m then return m end
            -- Case-insensitive scan
            for _, child in pairs(folder:GetChildren()) do
                if child.Name:lower() == name:lower()
                or child.Name:lower() == searchName:lower() then
                    return child
                end
            end
        end
    end

    -- Deep search in ReplicatedStorage
    for _, desc in pairs(ReplicatedStorage:GetDescendants()) do
        if desc:IsA("Tool") and (
            desc.Name:lower() == name:lower() or
            desc.Name:lower() == searchName:lower()
        ) then
            return desc
        end
    end

    return nil
end

-- Equip a weapon to the character (Character Tools ARE replicated → others see it)
local function equipWeapon(name, weaponType)
    local char = Player.Character
    if not char then return false, "No character" end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not hrp  then return false, "No HumanoidRootPart" end

    local model = findWeaponModel(name)

    if model then
        local clone = model:Clone()

        -- If it's a Chroma, try to mark it so effects apply
        if name:find("^Chroma ") then
            clone:SetAttribute("IsChroma", true)
            -- Chroma effect: tint all parts with animated color (rainbow)
            for _, part in pairs(clone:GetDescendants()) do
                if part:IsA("BasePart") then
                    -- Will cycle in loop below
                    part:SetAttribute("ChromaPart", true)
                end
            end
        end

        -- Remove currently equipped same-type weapon
        for _, existing in pairs(char:GetChildren()) do
            if existing:IsA("Tool") then existing:Destroy() end
        end

        clone.Parent = char  -- This replicates to all clients
        return true, "Equipped "..name
    else
        -- Model not found: create a placeholder visible tool
        -- with the godly name as a display
        return false, "Model not found for: "..name
    end
end

-- Add item to owned list (session tracking)
local function giveItem(name)
    if not OWNED[name] then
        OWNED[name] = true
        return true
    end
    return false -- already owned
end

-- ─── Chroma rainbow effect (runs on equipped Chroma items) ───────────────────
local chromaHue = 0
RunService.Heartbeat:Connect(function(dt)
    chromaHue = (chromaHue + dt * 0.5) % 1
    local char = Player.Character
    if not char then return end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:GetAttribute("IsChroma") then
            for _, part in pairs(tool:GetDescendants()) do
                if part:IsA("BasePart") and part:GetAttribute("ChromaPart") then
                    part.Color = Color3.fromHSV(chromaHue, 0.8, 1)
                end
            end
        end
    end
end)

