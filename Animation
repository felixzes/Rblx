local function switchTab(key)
    activeTab = key
    for _, b in pairs(tabBtns) do
        b.BackgroundColor3 = T.SIDEBAR
        b.TextColor3 = T.TEXTDIM
    end
    for _, p in pairs(tabPages) do p.Visible = false end
    if tabBtns[key] then
        tabBtns[key].BackgroundColor3 = T.BG3
        tabBtns[key].TextColor3 = T.TEXT
    end
    if tabPages[key] then tabPages[key].Visible = true end
end

