-- ─── TRAIL MODE ENGINE ───────────────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════════════

local RETURN_SPEED = 8

local function cancelReturn()
    trailReturning=false
    for _,c in ipairs(returnConns) do pcall(function() c:Disconnect() end) end
    returnConns={}
end

local function startReturn()
    cancelReturn()
    trailReturning=true
    for i,sw in ipairs(swords) do returnTargets[i]=sw.getFollowPos() end
    local conn
    conn=RunService.Heartbeat:Connect(function(dt)
        if not trailReturning then conn:Disconnect() return end
        local allDone=true
        for i,sw in ipairs(swords) do
            if sw.enabled then
                local target=returnTargets[i]
                if target then
                    local newPos=sw.centerPos:Lerp(target,math.min(1,RETURN_SPEED*dt))
                    sw.centerPos=newPos; sw.anchor.Position=newPos
                    if (newPos-target).Magnitude>0.05 then allDone=false end
                end
            end
        end
        if allDone then
            trailReturning=false; conn:Disconnect()
            for i,sw in ipairs(swords) do
                if sw.enabled then sw.centerPos=sw.getFollowPos(); sw.anchor.Position=sw.centerPos end
            end
        end
    end)
    table.insert(returnConns,conn)
end

local trailConn
local function startTrailEngine()
    if trailConn then trailConn:Disconnect() trailConn=nil end
    trailConn=RunService.Heartbeat:Connect(function(dt)
        if not trailEnabled then trailConn:Disconnect() trailConn=nil return end
        if not trailDragging then return end
        trailHistoryPush(swords[1].centerPos)
        for i=2,MAX_SWORDS do
            local sw=swords[i]
            if sw.enabled then
                local histPos=trailHistoryGet((i-1)*LAG_FRAMES)
                local TRAIL_LERP=math.min(1,22*dt)
                sw.centerPos=sw.centerPos:Lerp(histPos,TRAIL_LERP)
                sw.anchor.Position=sw.centerPos
            end
        end
    end)
end

local TRAIL_DEPTH=20

local function screenToWorldTrail(sp)
    local cam=Workspace.CurrentCamera; if not cam then return nil end
    local ray=cam:ScreenPointToRay(sp.X,sp.Y)
    return ray.Origin+ray.Direction*TRAIL_DEPTH
end

local function screenToWorld(sp,planeY)
    local cam=Workspace.CurrentCamera; if not cam then return nil end
    local ray=cam:ScreenPointToRay(sp.X,sp.Y)
    local d=ray.Direction
    if math.abs(d.Y)<0.0001 then return ray.Origin+d*200 end
    local t=(planeY-ray.Origin.Y)/d.Y
    if t<=0 then return ray.Origin+d*200 end
    return ray.Origin+d*t
end

-- ─── Follow engine ────────────────────────────────────────────────────────────
RunService.Heartbeat:Connect(function()
    if trailEnabled then return end
    if trailReturning then return end
    for _,sw in ipairs(swords) do
        if sw.enabled and not sw.fingerActive and not moveAllActive then
            sw.centerPos=sw.getFollowPos()
            sw.anchor.Position=sw.centerPos
        end
    end
end)

-- ─── Move-All engine ──────────────────────────────────────────────────────────
RunService.Heartbeat:Connect(function()
    if not moveAllEnabled or not moveAllActive then return end
    if trailEnabled then return end
    local cam=Workspace.CurrentCamera; if not cam then return end
    local cf=cam.CFrame
    local fwd=Vector3.new(cf.LookVector.X,0,cf.LookVector.Z)
    if fwd.Magnitude<0.01 then return end
    fwd=fwd.Unit
    local rgt=Vector3.new(cf.RightVector.X,0,cf.RightVector.Z).Unit
    local SPEED=0.55
    local move=(rgt*moveAllDelta.X+fwd*(-moveAllDelta.Y))*SPEED
    for i,sw in ipairs(swords) do
        if sw.enabled then
            local newPos=sw.centerPos+move
            local lockedY=moveAllLockedY[i] or sw.centerPos.Y
            sw.centerPos=Vector3.new(newPos.X,lockedY,newPos.Z)
            sw.anchor.Position=sw.centerPos
        end
    end
end)

