local function createNumInput(parent, yPos, labelText, cfgKey, onChange)
    local row = inst("Frame",{
        Size=UDim2.new(1,-16,0,30), Position=UDim2.new(0,8,0,yPos),
        BackgroundTransparency=1, Parent=parent,
    })
    label(row, labelText, UDim2.new(0,0,0,5), UDim2.new(0.6,0,1,0), 12, T.TEXT)
    local box = inst("TextBox",{
        Size=UDim2.new(0.38,0,0,24), Position=UDim2.new(0.62,0,0.5,-12),
        BackgroundColor3=T.BG3, Text=tostring(CFG[cfgKey]),
        TextColor3=T.TEXT, Font=Enum.Font.GothamSemiBold,
        TextSize=12, BorderSizePixel=0, ClearTextOnFocus=false, Parent=row,
    })
    corner(box, 5)
    pad(box, 3, 6, 3, 6)
    box.FocusLost:Connect(function()
        local v = tonumber(box.Text)
        if v then
            CFG[cfgKey] = v
            if onChange then onChange(v) end
            saveConfig()
        end
    end)
end

-- ─── Button ──────────────────────────────────────────────────────────────────
local function createBtn(parent, yPos, text, w, callback, accent)
    local btn = inst("TextButton",{
        Size=UDim2.new(w or 1, w and 0 or -16, 0, 30),
        Position=w and UDim2.new(0,8,0,yPos) or UDim2.new(0,8,0,yPos),
        BackgroundColor3=accent or T.ACCENT,
        Text=text, TextColor3=T.TEXT,
        Font=Enum.Font.GothamBold, TextSize=12,
        BorderSizePixel=0, Parent=parent,
    })
    corner(btn, 6)
    local tw = TweenService:Create(btn, TweenInfo.new(0.1),
        {BackgroundColor3=T.ACCENT2})
    btn.MouseEnter:Connect(function() tw:Play() end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn,TweenInfo.new(0.1),
            {BackgroundColor3=accent or T.ACCENT}):Play()
    end)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

