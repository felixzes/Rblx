-- ─── Trail input ──────────────────────────────────────────────────────────────
sharedOverlay.InputBegan:Connect(function(inp)
    if not trailEnabled then return end
    if inp.UserInputType~=Enum.UserInputType.Touch
    and inp.UserInputType~=Enum.UserInputType.MouseButton1 then return end
    if trailDragging then return end
    cancelReturn(); trailReturning=false
    trailDragging=true; trailTouch=inp
    local wp=screenToWorldTrail(Vector2.new(inp.Position.X,inp.Position.Y))
    if wp and swords[1].enabled then
        swords[1].centerPos=wp; swords[1].anchor.Position=wp
        for hi=1,HISTORY_SIZE do trailHistory[hi]=wp end
        trailHead=0
    end
    startTrailEngine()
end)

UserInputService.InputChanged:Connect(function(inp)
    if trailEnabled and trailDragging and inp==trailTouch then
        if inp.UserInputType~=Enum.UserInputType.Touch
        and inp.UserInputType~=Enum.UserInputType.MouseMovement then return end
        local wp=screenToWorldTrail(Vector2.new(inp.Position.X,inp.Position.Y))
        if wp and swords[1].enabled then
            swords[1].centerPos=wp; swords[1].anchor.Position=wp
        end
        return
    end
    local i=touchToSword[inp]
    if i then
        local sw=swords[i]; if not sw or not sw.fingerActive then return end
        if inp.UserInputType~=Enum.UserInputType.Touch
        and inp.UserInputType~=Enum.UserInputType.MouseMovement then return end
        local lockedY=swordDragY[i] or sw.centerPos.Y
        local wp=screenToWorld(Vector2.new(inp.Position.X,inp.Position.Y),lockedY)
        if wp then
            local locked=Vector3.new(wp.X,lockedY,wp.Z)
            sw.centerPos=locked; sw.anchor.Position=locked
            fingerDots[i].Position=UDim2.new(0,inp.Position.X,0,inp.Position.Y)
            fingerDots[i].Visible=true
        end
    end
    if moveAllActive and inp==moveAllTouch then
        local function ck(d,m) local mg=d.Magnitude return mg>m and (d/mg*m) or d end
        local d=Vector2.new(inp.Position.X,inp.Position.Y)-moveAllOrigin
        local c=ck(d,42); moveAllDelta=c
