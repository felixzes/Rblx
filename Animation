local updateClock = 0
RunService.Heartbeat:Connect(function(dt)
    updateClock = updateClock + dt
    if updateClock < 0.4 then return end
    updateClock = 0

    local str      = getStat("Strength") or getStat("Muscle") or 0
    local rebirths = getStat("Rebirths") or 0
    local elapsed  = os.time() - sessionStart
    local elapsedM = math.floor(elapsed / 60)

    -- Status bar
    statusLbl.Text = ("● Str: %s  |  Reb: %d  |  Session: %dm  |  %s"):format(
        formatNum(str), rebirths,
        elapsedM,
        (CFG.AutoPunch or CFG.AutoPushup) and "🟢 Farming" or "⚪ Idle"
    )

    -- Main page
    strLbl.Text       = "Strength    :  "..formatNum(str)
    rebLbl.Text       = "Rebirths    :  "..tostring(rebirths)
    sessionLbl.Text   = "Session     :  "..elapsedM.."m"
    glitchLbl.Text    = "Glitch XP   :  "..formatNum(glitchXP)

    local activeFeats = {}
    if CFG.AutoPunch     then table.insert(activeFeats, "Punch")   end
    if CFG.AutoPushup    then table.insert(activeFeats, "Pushup")  end
    if CFG.AutoRebirth   then table.insert(activeFeats, "Rebirth") end
    if CFG.AutoPetGlitch then table.insert(activeFeats, "Glitch")  end
    scriptLbl.Text = "Script      :  "..
        (#activeFeats > 0 and "🟢 "..table.concat(activeFeats,"+") or "⚪ Idle")

    -- Pet status
    local pets  = Player:FindFirstChild("Pets")
    local petStr = "None"
    if pets then
        local first = pets:GetChildren()[1]
        if first then
            petStr = first.Name..(first:FindFirstChild("Level") and " Lv"..first.Level.Value or "")
        end
    end
    petLbl.Text  = "Pet         :  "..petStr
    petStatLbl.Text = "Pet Stats   :  +"..
        (isGlitchable(rebirths) and "95/punch ✓" or "? (not glitchable)")

    -- Pet glitch page
    local glitchStatus = glitchActive and "🟢  ACTIVE" or "⚪  Inactive"
    glitchActive2.Text    = "Glitch Status  :  "..glitchStatus
    glitchStatLbl2.Text   = "Stats gained this session  :  "..formatNum(glitchStats)
    glitchXPLbl.Text      = "Pet XP  :  "..tostring(glitchXP)
    glitchPetLbl.Text     = "Active Glitch Pet  :  "..(currentGlitchPet and currentGlitchPet.Name or "None")
    nearestGlitch.Text    = "Next Glitchable  :  "..tostring(nextGlitchable(rebirths))
    targetRebLbl.Text     = "Target Rebirth  :  "..tostring(CFG.TargetRebirth).." (Max: Muscle King Rock)"
    isGlitchLbl.Text      = "Current Rebirth "..tostring(rebirths)..
        (isGlitchable(rebirths) and "  ✅  GLITCHABLE" or "  ❌  not glitchable")

    -- Rebirth page
    rebCountLbl.Text  = "Rebirths This Session  :  "..tostring(rebirthCount)
    curRebLbl.Text    = "Current Rebirths  :  "..tostring(rebirths)
    nextGlLbl.Text    = "Next Glitchable  :  "..tostring(nextGlitchable(rebirths))

    -- Auto size loop
    if CFG.AutoSize then applySize(CFG.TargetSize) end

    -- WalkSpeed / JumpPower enforcement
    local h = getHum()
    if h then
        if CFG.WalkSpeed ~= 16 then h.WalkSpeed = CFG.WalkSpeed end
        if CFG.JumpPower ~= 50 then h.JumpPower = CFG.JumpPower end
    end
end)

