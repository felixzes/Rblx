RunService.Heartbeat:Connect(function()
    for _,sw in ipairs(swords) do
        if sw.enabled then
            for i,part in ipairs(sw.parts) do
                if part.Parent and not part.Anchored then
                    local s=getSlot(i)
                    local rx,ry,rz=sw.rot(s.x,s.y,s.z)
                    local target=sw.centerPos+Vector3.new(rx,ry,rz)
                    local dir=target-part.Position
                    if dir.Magnitude>0 then part.Velocity=dir.Unit*999999 end
                end
            end
        end
    end
end)

-- ═══════════════════════════════════════════════════════════════════════════════
-- ─── TRAIL MODE ENGINE ───────────────────────────────────────────────────────
-- ═══════════════════════════════════════════════════════════════════════════════

-- return animation: lerps each sword's centerPos toward its formation slot
local RETURN_SPEED = 8   -- lerp alpha per second — higher = faster return

local function cancelReturn()
    trailReturning = false
    for _,c in ipairs(returnConns) do pcall(function() c:Disconnect() end) end
    returnConns = {}
end

local function startReturn()
    cancelReturn()
    trailReturning = true

    -- capture formation targets at the moment of release
    for i,sw in ipairs(swords) do
        returnTargets[i] = sw.getFollowPos()
    end

    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not trailReturning then conn:Disconnect() return end
        local allDone = true
        for i,sw in ipairs(swords) do
            if sw.enabled then
                local target = returnTargets[i]
                if target then
                    local newPos = sw.centerPos:Lerp(target, math.min(1, RETURN_SPEED * dt))
                    sw.centerPos = newPos
                    sw.anchor.Position = newPos
                    if (newPos - target).Magnitude > 0.05 then allDone = false end
                end
            end
        end
        if allDone then
            trailReturning = false
            conn:Disconnect()
            -- snap to exact formation
            for i,sw in ipairs(swords) do
                if sw.enabled then
                    sw.centerPos = sw.getFollowPos()
                    sw.anchor.Position = sw.centerPos
                end
            end
        end
    end)
    table.insert(returnConns, conn)
end

-- Trail heartbeat: drives all 8 swords from history
local trailConn
local function startTrailEngine()
    if trailConn then trailConn:Disconnect() trailConn = nil end
    trailConn = RunService.Heartbeat:Connect(function(dt)
        if not trailEnabled then trailConn:Disconnect() trailConn=nil return end
        if not trailDragging then return end

        -- sword 1 centerPos is set directly by finger input (instant)
        -- push it into the history buffer this frame
        trailHistoryPush(swords[1].centerPos)

        -- swords 2-8 each sample a progressively older position
        -- LAG_FRAMES gap between each sword gives the ribbon spacing
        for i=2, MAX_SWORDS do
            local sw = swords[i]
            if sw.enabled then
                local framesAgo = (i-1) * LAG_FRAMES
                local histPos   = trailHistoryGet(framesAgo)
                -- smooth lerp toward the historical position — removes any jitter
                local TRAIL_LERP = math.min(1, 22 * dt)
                sw.centerPos = sw.centerPos:Lerp(histPos, TRAIL_LERP)
                sw.anchor.Position = sw.centerPos
            end
        end
    end)
end

-- Screen → world for trail (full Y freedom — no plane lock)
-- projects onto a sphere at a fixed distance from camera
local TRAIL_DEPTH = 20  -- studs from camera toward look direction

local function screenToWorldTrail(sp)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local ray = cam:ScreenPointToRay(sp.X, sp.Y)
    -- place at fixed depth along the ray — gives full X and Y freedom
    return ray.Origin + ray.Direction * TRAIL_DEPTH
end

-- ─── Follow engine (normal mode) ─────────────────────────────────────────────
RunService.Heartbeat:Connect(function()
    if trailEnabled then return end     -- trail mode owns positioning
    if trailReturning then return end   -- return animation owns positioning
    for _,sw in ipairs(swords) do
        if sw.enabled and not sw.fingerActive and not moveAllActive then
            sw.centerPos=sw.getFollowPos()
            sw.anchor.Position=sw.centerPos
        end
    end
end)

-- ─── Move-All engine ──────────────────────────────────────────────────────────
RunService.Heartbeat:Connect(function()
    if not moveAllEnabled or not moveAllActive then return end
    if trailEnabled then return end
    local cam=Workspace.CurrentCamera; if not cam then return end
    local cf=cam.CFrame
    local fwd=Vector3.new(cf.LookVector.X,0,cf.LookVector.Z)
    if fwd.Magnitude<0.01 then return end
    fwd=fwd.Unit
    local rgt=Vector3.new(cf.RightVector.X,0,cf.RightVector.Z).Unit
    local SPEED=0.55
    local move=(rgt*moveAllDelta.X + fwd*(-moveAllDelta.Y))*SPEED
    for i,sw in ipairs(swords) do
        if sw.enabled then
            local newPos=sw.centerPos+move
            local lockedY=moveAllLockedY[i] or sw.centerPos.Y
            sw.centerPos=Vector3.new(newPos.X,lockedY,newPos.Z)
