    LP.ReplicationFocus = Workspace
    netConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            sethiddenproperty(LP,"SimulationRadius",    2147483647)
            sethiddenproperty(LP,"MaxSimulationRadius", 2147483647)
        end)
    end)
end
local function stopNet()
    if netConn then netConn:Disconnect(); netConn = nil end
end

-- ── character init (fix #12: single init path) ───────────────────────────────
local function initChar(c)
    stopAnim()
    char = c
    hrp  = c:WaitForChild("HumanoidRootPart")
    hum  = c:WaitForChild("Humanoid")
    task.wait(0.5)
    cacheMotors()
    killDefaultAnims()
    if animEnabled then startAnim() end   -- only one call
end

-- fix #21: cleanup on remove
LP.CharacterRemoving:Connect(function()
    stopAnim()
    motors = {}; defaultC0 = {}
    char = nil; hrp = nil; hum = nil
end)

-- fix #12: no double-startAnim on CharacterAdded
LP.CharacterAdded:Connect(function(c)
    task.wait(0.1)
    initChar(c)
end)

if LP.Character then initChar(LP.Character) end

