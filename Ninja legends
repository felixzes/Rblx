-- ─── Stats updater ────────────────────────────────────────────────────────────
local sessionStart = getRebirths()
local startTime    = os.time()

task.spawn(function()
    while true do
        task.wait(0.3)
        local cur      = getRebirths()
        local lv       = getLevel()
        local need     = getRebirthReq()
        local session  = cur - sessionStart
        local elapsed  = math.max(1, os.time()-startTime)
        local rate     = session/elapsed*3600
        local pct      = math.clamp(cur/CFG.target,0,1)

        rebirthLbl.Text = ("Rebirths: %d  /  %d"):format(cur,CFG.target)
        levelLbl.Text   = ("Level: %d  |  Need: %d  (formula: 50+%d×25)"):format(lv,need,cur)
        sessionLbl.Text = ("Session: +%d  |  Rate: %.0f/hr"):format(session,rate)
        pctLbl.Text     = ("%.4f%%  complete"):format(pct*100)
        barFill.Size    = UDim2.new(pct,0,1,0)
        barFill.BackgroundColor3 = Color3.fromHSV(0.78-(pct*0.78),1,1)

        if CFG.running and cur >= CFG.target then
            stopAll()
            statusLbl.Text="✅  TARGET REACHED!"
            statusLbl.TextColor3=C(255,255,80)
        end
    end
end)

