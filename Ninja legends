local function getVal(names)
    for _, n in ipairs(names) do
        local v = lp:FindFirstChild(n)
        if v and v.Value then return v.Value end
    end
    return 0
end
local function getLevel()    return getVal({"level","Level","Steps","steps","xp","XP"}) end
local function getRebirths() return getVal({"rebirths","Rebirths","rebirthCount","RebirthCount","totalRebirths"}) end
local function getRebirthReq() return 50 + getRebirths()*25 end

-- ─── Farm loops ──────────────────────────────────────────────────────────────

-- Loop 1: Hoop touch glitch
local hoopConn
local function startHoopGlitch()
    if hoopConn then return end
    hoopConn = RunService.Stepped:Connect(function()
        if not CFG.running or not CFG.hoopGlitch then return end
        local char = lp.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local hoopFolder = workspace:FindFirstChild("Hoops")
        if not hoopFolder then return end
        for _, hoop in next, hoopFolder:GetChildren() do
            pcall(function()
                firetouchinterest(hrp, hoop, 0)
                firetouchinterest(hrp, hoop, 1)
            end)
        end
    end)
end
local function stopHoopGlitch()
    if hoopConn then hoopConn:Disconnect() hoopConn = nil end
end

-- Loop 2: OrbEvent spam glitch — only fires selected orbs × selected zones
local function buildOrbArgs()
    local args = {}
    for _, o in ipairs(ALL_ORBS) do
        if orbEnabled[o.key] then
            for _, z in ipairs(ALL_ZONES) do
                if zoneEnabled[z] then
                    table.insert(args, {"collectOrb", o.key, z})
                end
            end
        end
    end
    return args
end

local orbRunning = false
local function startOrbGlitch()
    if orbRunning then return end
    orbRunning = true
    task.spawn(function()
        while CFG.running and CFG.orbGlitch do
            local args = buildOrbArgs()
            for _, a in ipairs(args) do
                for _ = 1, CFG.orbBurst do
                    pcall(function()
                        orbEvent:FireServer(table.unpack(a))
                    end)
                end
            end
            task.wait()
        end
        orbRunning = false
    end)
end

-- Loop 3: RebirthEvent loop glitch
local rebirthRunning = false
local function startRebirthGlitch()
    if rebirthRunning then return end
    rebirthRunning = true
    task.spawn(function()
        while CFG.running and CFG.rebirthGlitch do
            pcall(function()
                rebirthEvent:FireServer("rebirthRequest")
            end)
            task.wait(CFG.rebirthRate)
        end
        rebirthRunning = false
    end)
end

local function startAll()
    CFG.running = true
    startHoopGlitch()
    startOrbGlitch()
    startRebirthGlitch()
end

local function stopAll()
    CFG.running = false
    stopHoopGlitch()
end

