local function mkFrame(p,sz,pos,bg,bgT,r)
    local f=Instance.new("Frame")
    f.Size=sz f.Position=pos or UDim2.new(0,0,0,0)
    f.BackgroundColor3=bg or C(12,4,20) f.BackgroundTransparency=bgT or 0
    f.BorderSizePixel=0 f.Parent=p
    if r then Instance.new("UICorner",f).CornerRadius=UDim.new(0,r) end
    return f
end
local function mkLbl(p,text,pos,sz,fs,fc,align,z)
    local L=Instance.new("TextLabel")
    L.Text=text L.Size=sz or UDim2.new(1,0,0,18)
    L.Position=pos or UDim2.new(0,0,0,0)
    L.TextColor3=fc or C(220,220,255) L.BackgroundTransparency=1
    L.Font=Enum.Font.GothamBold L.TextSize=fs or 11
    L.TextXAlignment=align or Enum.TextXAlignment.Left
    L.BorderSizePixel=0 L.ZIndex=z or 7 L.Parent=p
    return L
end
local function mkBtn(p,text,pos,sz,bg,tc,fs,r)
    local B=Instance.new("TextButton")
    B.Size=sz or UDim2.new(1,0,0,28) B.Position=pos or UDim2.new(0,0,0,0)
    B.Text=text B.BackgroundColor3=bg or C(40,0,80)
    B.TextColor3=tc or C(255,255,255)
    B.Font=Enum.Font.GothamBold B.TextSize=fs or 12
    B.BorderSizePixel=0 B.ZIndex=8 B.Parent=p
    Instance.new("UICorner",B).CornerRadius=UDim.new(0,r or 8)
    return B
end
local function mkStroke(p,col,t)
    local s=Instance.new("UIStroke",p) s.Color=col or C(80,0,140) s.Thickness=t or 1.2
    return s
end
local function mkScroll(p,sz,pos)
    local sc=Instance.new("ScrollingFrame")
    sc.Size=sz sc.Position=pos or UDim2.new(0,0,0,0)
    sc.BackgroundTransparency=1 sc.BorderSizePixel=0
    sc.ScrollBarThickness=3
    sc.ScrollBarImageColor3=C(120,0,220)
    sc.CanvasSize=UDim2.new(0,0,0,0)
    sc.AutomaticCanvasSize=Enum.AutomaticSize.Y
    sc.Parent=p
    Instance.new("UIListLayout",sc).Padding=UDim.new(0,4)
    return sc
end

