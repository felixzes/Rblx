-- VOID FLOOR
-- ═══════════════════════════════════════════════════════
local VOID_Y    = -100
local FLOOR_Y   = -80
local floorPart = nil

local function spawnFloor()
    if floorPart and floorPart.Parent then return end
    floorPart              = Instance.new("Part")
    floorPart.Name         = "VoidFloor"
    floorPart.Anchored     = true
    floorPart.CanCollide   = true
    floorPart.Size         = Vector3.new(500, 2, 500)
    floorPart.Position     = Vector3.new(hrp.Position.X, FLOOR_Y, hrp.Position.Z)
    floorPart.BrickColor   = BrickColor.new("Dark stone grey")
    floorPart.Material     = Enum.Material.SmoothPlastic
    floorPart.Transparency = 0.4
    floorPart.Parent       = Workspace
    hrp.CFrame   = CFrame.new(hrp.Position.X, FLOOR_Y + 2, hrp.Position.Z)
    hrp.Velocity = Vector3.zero
    task.delay(10, function()
        if floorPart and floorPart.Parent then floorPart:Destroy(); floorPart = nil end
    end)
end

RunService.Heartbeat:Connect(function()
    local c = LP.Character; if not c then return end
    local h = c:FindFirstChild("HumanoidRootPart"); if not h then return end
    if h.Position.Y < VOID_Y then spawnFloor() end
    if floorPart and floorPart.Parent then
        floorPart.Position = Vector3.new(h.Position.X, FLOOR_Y, h.Position.Z)
    end
end)

LP.CharacterAdded:Connect(function(c)
    char = c; hrp = c:WaitForChild("HumanoidRootPart")
    if sfOn then task.wait(0.5); sfStart() end
end)

-- ═══════════════════════════════════════════════════════
-- VFX NUKE — removes everything visual in the entire game
-- ═══════════════════════════════════════════════════════
local vfxOn      = false
local vfxConns   = {}

local VFX_CLASSES = {
    "ParticleEmitter","Trail","Beam","Smoke","Fire","Sparkles",
    "BillboardGui","SurfaceGui","SurfaceAppearance",
    "PointLight","SpotLight","SurfaceLight",
    "SelectionBox","SelectionSphere","BoxHandleAdornment",
    "SphereHandleAdornment","ConeHandleAdornment",
    "ImageHandleAdornment","LineHandleAdornment",
    "WireframeHandleAdornment",
}

local LIGHTING_FX = {
    "BlurEffect","BloomEffect","ColorCorrectionEffect",
    "SunRaysEffect","DepthOfFieldEffect","ColorGradingEffect",
    "FilmGrainEffect","GlassBlurEffect",
}

local SKY_CLASSES = {
    "Sky","Atmosphere",
}

local function killObj(obj)
    if not obj or not obj.Parent then return end
    if obj:IsA("Explosion") then
        pcall(function()
            obj.BlastPressure = 0
            obj.BlastRadius   = 0
        end)
        return
    end
    for _, cls in ipairs(VFX_CLASSES) do
        if obj:IsA(cls) then pcall(function() obj:Destroy() end); return end
    end
end

local function killLighting()
    for _, obj in ipairs(Lighting:GetChildren()) do
        for _, cls in ipairs(LIGHTING_FX) do
            if obj:IsA(cls) then pcall(function() obj:Destroy() end) end
        end
        for _, cls in ipairs(SKY_CLASSES) do
            if obj:IsA(cls) then pcall(function() obj:Destroy() end) end
        end
    end
    -- flatten ambient so the game doesn't look pitch black
    pcall(function()
        Lighting.Brightness       = 2
        Lighting.GlobalShadows    = false
        Lighting.FogEnd           = 100000
        Lighting.FogStart         = 100000
        Lighting.Ambient          = Color3.fromRGB(128,128,128)
        Lighting.OutdoorAmbient   = Color3.fromRGB(128,128,128)
    end)
end

local function sweepAll()
    -- sweep entire game tree
    for _, service in ipairs({Workspace, game:GetService("ReplicatedStorage"), game:GetService("StarterGui")}) do
        pcall(function()
            for _, obj in ipairs(service:GetDescendants()) do
                killObj(obj)
            end
        end)
    end
    killLighting()
end

local function startVFX()
    vfxOn = true
    sweepAll()

    -- watch new objects everywhere
    local c1 = Workspace.DescendantAdded:Connect(function(obj)
        if vfxOn then task.defer(function() killObj(obj) end) end
    end)
    local c2 = Lighting.ChildAdded:Connect(function(obj)
        if not vfxOn then return end
        for _, cls in ipairs(LIGHTING_FX) do
            if obj:IsA(cls) then pcall(function() obj:Destroy() end) end
        end
    end)
    -- re-sweep every 3 seconds to catch anything that slipped through
    local c3 = RunService.Heartbeat:Connect(function()
        if not vfxOn then return end
    end)
    local sweepTimer = 0
    local c4 = RunService.Heartbeat:Connect(function(dt)
        if not vfxOn then return end
        sweepTimer = sweepTimer + dt
        if sweepTimer < 3 then return end
        sweepTimer = 0
        sweepAll()
    end)
    table.insert(vfxConns, c1)
    table.insert(vfxConns, c2)
    table.insert(vfxConns, c3)
    table.insert(vfxConns, c4)
end

local function stopVFX()
    vfxOn = false
    for _, c in ipairs(vfxConns) do c:Disconnect() end
    vfxConns = {}
end

