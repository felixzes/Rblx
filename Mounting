-- ── full-panel resize drag ────────────────────────
-- drags from any edge/corner within 10px, otherwise moves the panel
local EDGE = 10
local dragMode = nil  -- "move" | "tl" | "tr" | "bl" | "br" | "l" | "r" | "t" | "b"
local dragStart = Vector2.zero
local panelStartPos, panelStartSize

local function getEdgeMode(lx, ly)
    local pw, ph = panel.AbsoluteSize.X, panel.AbsoluteSize.Y
    local onL = lx < EDGE
    local onR = lx > pw - EDGE
    local onT = ly < EDGE
    local onB = ly > ph - EDGE
    if onT and onL then return "tl"
    elseif onT and onR then return "tr"
    elseif onB and onL then return "bl"
    elseif onB and onR then return "br"
    elseif onL then return "l"
    elseif onR then return "r"
    elseif onT then return "t"
    elseif onB then return "b"
    end
    return "move"
end

panel.InputBegan:Connect(function(i)
    if i.UserInputType ~= Enum.UserInputType.MouseButton1
    and i.UserInputType ~= Enum.UserInputType.Touch then return end
    local lx = i.Position.X - panel.AbsolutePosition.X
    local ly = i.Position.Y - panel.AbsolutePosition.Y
    dragMode        = getEdgeMode(lx, ly)
    dragStart       = Vector2.new(i.Position.X, i.Position.Y)
    panelStartPos   = panel.Position
    panelStartSize  = panel.Size
    i.Changed:Connect(function()
        if i.UserInputState == Enum.UserInputState.End then dragMode = nil end
    end)
end)

UserInputService.InputChanged:Connect(function(i)
    if not dragMode then return end
    if i.UserInputType ~= Enum.UserInputType.MouseMovement
    and i.UserInputType ~= Enum.UserInputType.Touch then return end
    local dx = i.Position.X - dragStart.X
    local dy = i.Position.Y - dragStart.Y
    local ox  = panelStartPos.X.Offset
    local oy  = panelStartPos.Y.Offset
    local ow  = panelStartSize.X.Offset
    local oh  = panelStartSize.Y.Offset
    local MIN = 200

    if dragMode == "move" then
        panel.Position = UDim2.new(panelStartPos.X.Scale, ox+dx, panelStartPos.Y.Scale, oy+dy)
    elseif dragMode == "r" then
        panel.Size = UDim2.new(0, math.max(MIN,ow+dx), 0, oh)
    elseif dragMode == "l" then
        local nw = math.max(MIN, ow-dx)
        panel.Position = UDim2.new(panelStartPos.X.Scale, ox+(ow-nw), panelStartPos.Y.Scale, oy)
        panel.Size     = UDim2.new(0, nw, 0, oh)
    elseif dragMode == "b" then
        panel.Size = UDim2.new(0, ow, 0, math.max(MIN,oh+dy))
    elseif dragMode == "t" then
        local nh = math.max(MIN, oh-dy)
        panel.Position = UDim2.new(panelStartPos.X.Scale, ox, panelStartPos.Y.Scale, oy+(oh-nh))
        panel.Size     = UDim2.new(0, ow, 0, nh)
    elseif dragMode == "br" then
        panel.Size = UDim2.new(0, math.max(MIN,ow+dx), 0, math.max(MIN,oh+dy))
    elseif dragMode == "bl" then
        local nw = math.max(MIN, ow-dx)
        panel.Position = UDim2.new(panelStartPos.X.Scale, ox+(ow-nw), panelStartPos.Y.Scale, oy)
        panel.Size     = UDim2.new(0, nw, 0, math.max(MIN,oh+dy))
    elseif dragMode == "tr" then
        local nh = math.max(MIN, oh-dy)
        panel.Position = UDim2.new(panelStartPos.X.Scale, ox, panelStartPos.Y.Scale, oy+(oh-nh))
        panel.Size     = UDim2.new(0, math.max(MIN,ow+dx), 0, nh)
    elseif dragMode == "tl" then
        local nw = math.max(MIN, ow-dx)
        local nh = math.max(MIN, oh-dy)
        panel.Position = UDim2.new(panelStartPos.X.Scale, ox+(ow-nw), panelStartPos.Y.Scale, oy+(oh-nh))
        panel.Size     = UDim2.new(0, nw, 0, nh)
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        dragMode = nil
    end
end)

