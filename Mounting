local ToggleBtn  = makeBtn("Mount: OFF",          44,  180, 0,   0)
local HitboxBtn  = makeBtn("Hitbox Expand: OFF",  90,  0,   100, 180)
local NoclipBtn  = makeBtn("Noclip: OFF",         136, 60,  0,   140)
