-- ═══════════════════════════════════════════════════════
-- SHADOW FOLLOW
-- ═══════════════════════════════════════════════════════
local dist   = 5
local sfOn   = false
local sfConn = nil
local sfScan = nil
local target = nil

local function getHRP(p)
    return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
end

local function nearest()
    local myH = getHRP(LP); if not myH then return nil end
    local best, bestD = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local h = getHRP(p)
            if h then
                local d = (h.Position - myH.Position).Magnitude
                if d < bestD then bestD = d; best = p end
            end
        end
    end
    return best
end

local sfStatusLbl, sfTargetLbl, sfToggleBtn

local function sfStop()
    if sfConn then sfConn:Disconnect(); sfConn = nil end
    if sfScan then sfScan:Disconnect(); sfScan = nil end
end

local sfStart
sfStart = function()
    sfStop()
    if not sfOn then return end
    target = nearest()
    if sfStatusLbl then
        sfStatusLbl.Text       = target and "● following" or "● no players"
        sfStatusLbl.TextColor3 = target and Color3.fromRGB(80,220,120) or Color3.fromRGB(220,100,60)
        sfTargetLbl.Text       = target and target.Name or ""
    end
    if not target then return end
    sfConn = RunService.Heartbeat:Connect(function()
        if not sfOn then return end
        local myH = getHRP(LP); local tH = getHRP(target)
        if not myH or not tH then target = nearest(); return end
        local behind = tH.CFrame.Position - tH.CFrame.LookVector * dist
        myH.CFrame      = CFrame.new(Vector3.new(behind.X, tH.Position.Y, behind.Z), tH.CFrame.Position)
        myH.Velocity    = Vector3.zero
        myH.RotVelocity = Vector3.zero
    end)
    local t = 0
    sfScan = RunService.Heartbeat:Connect(function(dt)
        t = t + dt; if t < 2 then return end; t = 0
        local n = nearest()
        if n and n ~= target then
            target = n
            if sfTargetLbl then sfTargetLbl.Text = target.Name end
        end
    end)
end

-- ═══════════════════════════════════════════════════════
-- HITBOX EXPANDER
-- ═══════════════════════════════════════════════════════
local HIT_SIZE   = 20
local hitOn      = false
local expanded   = {}
local expandConn = nil

local function expandPlayer(p)
    if p == LP then return end
    local c = p.Character; if not c then return end
    if expanded[p] then return end
    expanded[p] = {}
    for _, obj in ipairs(c:GetDescendants()) do
        if obj:IsA("BasePart") then
            expanded[p][obj] = obj.Size
            pcall(function() obj.Size = Vector3.new(HIT_SIZE,HIT_SIZE,HIT_SIZE) end)
        end
    end
end

local function restorePlayer(p)
    if not expanded[p] then return end
    for part, sz in pairs(expanded[p]) do
        if part and part.Parent then pcall(function() part.Size = sz end) end
    end
    expanded[p] = nil
end

local function startHitbox()
    hitOn = true
    for _, p in ipairs(Players:GetPlayers()) do expandPlayer(p) end
    expandConn = RunService.Heartbeat:Connect(function()
        if not hitOn then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                if not expanded[p] then expandPlayer(p)
                else
                    local c = p.Character
                    if c then
                        for _, obj in ipairs(c:GetDescendants()) do
                            if obj:IsA("BasePart") and obj.Size.Magnitude < HIT_SIZE then
                                pcall(function() obj.Size = Vector3.new(HIT_SIZE,HIT_SIZE,HIT_SIZE) end)
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function stopHitbox()
    hitOn = false
    if expandConn then expandConn:Disconnect(); expandConn = nil end
    for _, p in ipairs(Players:GetPlayers()) do restorePlayer(p) end
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.5); if hitOn then expandPlayer(p) end
    end)
end)
Players.PlayerRemoving:Connect(function(p) expanded[p] = nil end)

