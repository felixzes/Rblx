local TargetLabel = makeLabel("Target: none", 370)

-- ─── setBtn ──────────────────────────────────────
local function setBtn(on)
    mounted                    = on
    ToggleBtn.Text             = on and "Mount: ON" or "Mount: OFF"
    ToggleBtn.BackgroundColor3 = on
        and Color3.fromRGB(40, 180, 60)
        or  Color3.fromRGB(180, 0, 0)
    TargetLabel.Text = on and targetPlayer
        and ("Target: " .. targetPlayer.Name)
        or  "Target: none"
end

-- ─── stop ────────────────────────────────────────
local function stop()
    if lockConn then lockConn:Disconnect(); lockConn = nil end
    targetPlayer = nil
    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,  true)
        humanoid:ChangeState(Enum.HumanoidStateType.GravityScale)
    end)
    setBtn(false)
end
getgenv().stopMount = stop

-- ─── CFrame builder ──────────────────────────────
local function buildFaceDownCFrame(pos, yaw)
    return CFrame.new(pos)
        * CFrame.Angles(0, yaw, 0)
        * CFrame.Angles(-math.pi / 2, 0, 0)
end

-- ─── mount ───────────────────────────────────────
local function mount(p)
    if lockConn then lockConn:Disconnect(); lockConn = nil end
    targetPlayer = p

    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,  false)
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    end)

    setBtn(true)

    lockConn = RunService.Heartbeat:Connect(function()
        local tp = targetPlayer
        if not tp or not tp.Character then
            -- auto-retarget if enabled
            if AUTO_RETARGET then
                local next = nearest()
                if next then mount(next) end
            else
                stop()
            end
            return
        end

        local th = tp.Character:FindFirstChild("Humanoid")
        if th and th.Health <= 0 then
            if AUTO_RETARGET then
                local next = nearest(tp)
                if next then
                    task.delay(0.3, function() mount(next) end)
                else
                    stop()
                end
            else
                stop()
            end
            return
        end

        local tRoot = tp.Character:FindFirstChild("HumanoidRootPart")
        local tHead = tp.Character:FindFirstChild("Head")
        if not tRoot then stop(); return end

        local headTopY = tHead
            and (tHead.Position.Y + tHead.Size.Y * 0.5)
            or  (tRoot.Position.Y + 3)

        local pos = Vector3.new(
            tRoot.Position.X,
            headTopY + ABOVE + HIT_OFFSET,
            tRoot.Position.Z
        )

        local _, yaw, _ = tRoot.CFrame:ToEulerAnglesYXZ()

        pcall(function()
            hrp.Velocity    = Vector3.zero
            hrp.RotVelocity = Vector3.zero
        end)

        hrp.CFrame = buildFaceDownCFrame(pos, yaw)

        pcall(function()
            hrp.Velocity    = Vector3.zero
            hrp.RotVelocity = Vector3.zero
        end)
    end)
end

-- ─── button wiring ───────────────────────────────
ToggleBtn.MouseButton1Click:Connect(function()
    if mounted then
        stop()
    else
        local target = nearest()
        if target then
            mount(target)
        else
            TargetLabel.Text = "No players found"
        end
    end
end)

HitboxBtn.MouseButton1Click:Connect(function()
    if hitboxExpanded then
        restoreHitbox(character)
        HitboxBtn.Text             = "Hitbox Expand: OFF"
        HitboxBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 180)
    else
        expandHitbox(character)
        HitboxBtn.Text             = "Hitbox Expand: ON"
        HitboxBtn.BackgroundColor3 = Color3.fromRGB(50, 205, 50)
    end
end)

NoclipBtn.MouseButton1Click:Connect(function()
    if noclipOn then
        disableNoclip()
        NoclipBtn.Text             = "Noclip: OFF"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(60, 0, 140)
    else
        enableNoclip()
        NoclipBtn.Text             = "Noclip: ON"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(160, 0, 255)
    end
end)

AuraBtn.MouseButton1Click:Connect(function()
    KILL_AURA = not KILL_AURA
    if KILL_AURA then
        startAura()
        AuraBtn.Text             = "Kill Aura: ON"
        AuraBtn.BackgroundColor3 = Color3.fromRGB(220, 80, 0)
    else
        stopAura()
        AuraBtn.Text             = "Kill Aura: OFF"
        AuraBtn.BackgroundColor3 = Color3.fromRGB(100, 60, 0)
    end
end)

RetargetBtn.MouseButton1Click:Connect(function()
