end)

-- ─── respawn ─────────────────────────────────────
LocalPlayer.CharacterAdded:Connect(function(c)
    character      = c
    hrp            = c:WaitForChild("HumanoidRootPart")
    humanoid       = c:WaitForChild("Humanoid")
    origSizes      = {}
    hitboxExpanded = false
    noclipOn       = false
    noclipConn     = nil
    if targetPlayer then
        task.wait(0.5)
        mount(targetPlayer)
    end
end)

