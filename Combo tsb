        UDim2.new(0,8,0,yPos), UDim2.new(0.55,0,0,16), 10, C(160,160,180))
    local val = lbl(parent, tostring(getF()),
        UDim2.new(0.6,0,0,yPos), UDim2.new(0.18,0,0,16), 10, C(255,220,120),
        Enum.TextXAlignment.Center)
    local dBtn = btn(parent, "−",
        UDim2.new(0.80,0,0,yPos-2), UDim2.new(0.09,0,0,18), C(80,20,0), C(255,255,255), 11)
    local uBtn = btn(parent, "+",
        UDim2.new(0.90,0,0,yPos-2), UDim2.new(0.09,0,0,18), C(0,80,20), C(255,255,255), 11)
    dBtn.MouseButton1Click:Connect(function()
        setF(math.max(0.01, getF()-step))
        val.Text = string.format("%.2f", getF())
    end)
    uBtn.MouseButton1Click:Connect(function()
        setF(getF()+step)
        val.Text = string.format("%.2f", getF())
    end)
end

