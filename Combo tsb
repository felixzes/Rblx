--[[
    The Strongest Battlegrounds — Auto Kyoto Combo
    Character: Hero Hunter (Garou)
    
    Combo sequence:
    Approach Dash → 3 M1 → Mini Uppercut (M1+Jump) →
    Flowing Water [Q] → Side Dash (Kyoto tech) →
    Lethal Whirlwind Stream [E] → Whirlwind Dash Tech →
    Hunter's Grasp [R] → 3 M1 + Downslam (optional ender)
    
    Requires: executor with VirtualInputManager access
    (Delta, Fluxus, Arceus X, Hydrogen, Solara, etc.)
]]

-- ─── Services ────────────────────────────────────────────────────────────────
local Players         = game:GetService("Players")
local RunService      = game:GetService("RunService")
local UserInputService= game:GetService("UserInputService")
local TweenService    = game:GetService("TweenService")
local VIM             = game:GetService("VirtualInputManager")

local Player  = Players.LocalPlayer
local Camera  = workspace.CurrentCamera

-- ─── Config (tune these if combo breaks) ─────────────────────────────────────
local CFG = {
    -- Range
    DETECT_RANGE    = 80,    -- max stud range to target enemies
    
    -- M1 timing (seconds)
    M1_INTERVAL     = 0.33,  -- gap between each M1 hit
    M1_HOLD         = 0.05,  -- how long click is held
    
    -- Ability timing
    UPPERCUT_DELAY  = 0.05,  -- Jump fires this many seconds before 4th M1
    POST_UPPER      = 0.12,  -- settle time after mini uppercut
    FW_CAST_DELAY   = 0.05,  -- time before Flowing Water fires
    POST_FW         = 0.18,  -- time after Flowing Water before side dash
    SIDE_DASH_HOLD  = 0.06,  -- double-tap gap for side dash
    POST_DASH       = 0.10,  -- settle after dash
    LWS_CAST_DELAY  = 0.03,  -- time before Lethal Whirlwind fires
    POST_LWS        = 0.06,  -- time after LWS before Whirlwind Dash Tech
    WDT_DELAY       = 0.07,  -- Whirlwind Dash Tech gap
    POST_WDT        = 0.14,  -- settle after WDT
    HG_CAST_DELAY   = 0.03,  -- time before Hunter's Grasp
    POST_HG         = 0.20,  -- settle after ender
    
    -- Cycle
    COMBO_COOLDOWN  = 0.5,   -- seconds between combo loops (AUTO mode)
    APPROACH_DIST   = 12,    -- studs — dash toward target if further than this
    
    -- Ender toggle
    FULL_ENDER      = true,  -- do post-HG M1 downslam ender
}

-- ─── Key bindings (Hero Hunter default PC layout) ─────────────────────────────
-- Executors simulate these via VIM even on mobile
local KEYS = {
    SKILL_1  = Enum.KeyCode.Q,         -- Flowing Water / Water Stream Cutting Fist
    SKILL_2  = Enum.KeyCode.E,         -- Lethal Whirlwind Stream
    SKILL_3  = Enum.KeyCode.R,         -- Hunter's Grasp
    SKILL_4  = Enum.KeyCode.F,         -- Prey's Peril (not used in base Kyoto)
    JUMP     = Enum.KeyCode.Space,
    BLOCK    = Enum.KeyCode.LeftShift,
    FWD      = Enum.KeyCode.W,         -- forward dash: double-tap
    BACK     = Enum.KeyCode.S,
    LEFT     = Enum.KeyCode.A,         -- side dash left: double-tap
    RIGHT    = Enum.KeyCode.D,         -- side dash right: double-tap
}

-- ─── State ────────────────────────────────────────────────────────────────────
local RUNNING      = false   -- auto-loop on/off
local COMBO_ACTIVE = false   -- currently executing
local CURRENT_PHASE= "Idle"
local LOCKED_TARGET= nil     -- sticky target across combo
local COMBOS_DONE  = 0

-- ─── VIM input helpers ────────────────────────────────────────────────────────
local function keyDown(kc)   VIM:SendKeyEvent(true,  kc, false, game) end
local function keyUp(kc)     VIM:SendKeyEvent(false, kc, false, game) end

local function pressKey(kc, holdTime)
    keyDown(kc)
    task.wait(holdTime or 0.05)
    keyUp(kc)
end

-- Double-tap = dash in TSB
local function doubleTap(kc, tapHold, tapGap)
    pressKey(kc, tapHold or 0.04)
    task.wait(tapGap or 0.07)
    pressKey(kc, tapHold or 0.04)
end

-- Simulate M1 click at screen coordinates
local function clickM1(x, y, hold)
    VIM:SendMouseButtonEvent(x, y, 0, true,  game, 0)
    task.wait(hold or CFG.M1_HOLD)
    VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

-- ─── Targeting ────────────────────────────────────────────────────────────────
local function getMyRoot()
    local c = Player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function findNearest()
    local myRoot = getMyRoot()
    if not myRoot then return nil end
    local best, bestDist = nil, CFG.DETECT_RANGE
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
            local pHum  = p.Character:FindFirstChild("Humanoid")
            if pRoot and pHum and pHum.Health > 0 then
                local d = (pRoot.Position - myRoot.Position).Magnitude
                if d < bestDist then bestDist = d; best = p end
            end
        end
    end
    return best
end

local function targetRoot(target)
    if not target or not target.Character then return nil end
    return target.Character:FindFirstChild("HumanoidRootPart")
end

-- Face character + camera toward target
local function faceTarget(target)
    local myRoot = getMyRoot()
    local tRoot  = targetRoot(target)
    if not myRoot or not tRoot then return end
    local dir = Vector3.new(tRoot.Position.X - myRoot.Position.X, 0, tRoot.Position.Z - myRoot.Position.Z).Unit
    myRoot.CFrame = CFrame.new(myRoot.Position, myRoot.Position + dir)
    Camera.CFrame  = CFrame.new(Camera.CFrame.Position, tRoot.Position)
end

-- Get screen position of target (for M1 click)
local function targetScreenPos(target)
    local tRoot = targetRoot(target)
    local vp    = Camera.ViewportSize
    local cx, cy = vp.X / 2, vp.Y / 2
    if not tRoot then return cx, cy end
    local sp, onScreen = Camera:WorldToScreenPoint(tRoot.Position)
    if onScreen then return sp.X, sp.Y end
    return cx, cy
end

-- ─── Approach toward target ───────────────────────────────────────────────────
local function approachTarget(target)
    local myRoot = getMyRoot()
    local tRoot  = targetRoot(target)
    if not myRoot or not tRoot then return end
    local dist = (tRoot.Position - myRoot.Position).Magnitude
    if dist > CFG.APPROACH_DIST then
        faceTarget(target)
        doubleTap(KEYS.FWD, 0.05, 0.07)
        task.wait(0.25)
    end
end

-- ─── KYOTO COMBO EXECUTOR ─────────────────────────────────────────────────────
local phaseLabel = nil  -- set after GUI is created, updated here

local function setPhase(txt)
    CURRENT_PHASE = txt
    if phaseLabel then phaseLabel.Text = "Phase: " .. txt end
end

local function kyotoCombo()
    if COMBO_ACTIVE then return end
    COMBO_ACTIVE = true

    -- Find / sticky target
    local target = LOCKED_TARGET or findNearest()
    if not target or not target.Character then
        COMBO_ACTIVE = false; setPhase("No target"); return
    end
    LOCKED_TARGET = target  -- lock for duration of combo

    local tRoot = targetRoot(target)
    if not tRoot then COMBO_ACTIVE = false; return end

    -- ── Phase 0: Approach ────────────────────────────────────────────────────
    setPhase("0 · Approach")
    approachTarget(target)
    faceTarget(target)
    local sx, sy = targetScreenPos(target)

    -- ── Phase 1: 3x M1 ───────────────────────────────────────────────────────
    setPhase("1 · M1 × 3")
    for i = 1, 3 do
        faceTarget(target)
        sx, sy = targetScreenPos(target)
        clickM1(sx, sy)
        task.wait(CFG.M1_INTERVAL)
    end

    -- ── Phase 2: Mini Uppercut (4th M1 + Jump) ───────────────────────────────
    -- Jump fires slightly before 4th M1 to trigger mini uppercut hitbox
    setPhase("2 · Mini Uppercut")
    faceTarget(target)
    sx, sy = targetScreenPos(target)
    task.spawn(function()
        task.wait(CFG.UPPERCUT_DELAY)
        clickM1(sx, sy)
    end)
    pressKey(KEYS.JUMP, 0.05)
    task.wait(CFG.POST_UPPER)
    -- Enemy is now launched upward via Martial Artist passive

    -- ── Phase 3: Flowing Water (Skill Q) ─────────────────────────────────────
    -- Unblockable rush — catches airborne target
    setPhase("3 · Flowing Water [Q]")
    faceTarget(target)
    task.wait(CFG.FW_CAST_DELAY)
    pressKey(KEYS.SKILL_1, 0.06)
    task.wait(CFG.POST_FW)

    -- ── Phase 4: Kyoto Tech — Side Dash ──────────────────────────────────────
    -- ShiftLock OFF needed; side-dash reposition
    -- Dash direction: right (D) — flips to catch enemy as they fall
    setPhase("4 · Kyoto Side Dash")
    doubleTap(KEYS.RIGHT, CFG.SIDE_DASH_HOLD, 0.06)
    task.wait(CFG.POST_DASH)
    faceTarget(target)

    -- ── Phase 5: Lethal Whirlwind Stream (Skill E) ───────────────────────────
    -- Catches enemy mid-air after Flowing Water bounce
    -- 1→2 order: LWS finisher = 21% kill verdict (better than 2→1)
    setPhase("5 · Lethal Whirlwind [E]")
    task.wait(CFG.LWS_CAST_DELAY)
    pressKey(KEYS.SKILL_2, 0.06)
    task.wait(CFG.POST_LWS)

    -- ── Phase 5b: Whirlwind Dash Tech ────────────────────────────────────────
    -- Front dash in arc IMMEDIATELY after LWS — reduces knockback, keeps enemy close
    setPhase("5b · Whirlwind Dash Tech")
    doubleTap(KEYS.FWD, 0.04, CFG.WDT_DELAY)
    task.wait(CFG.POST_WDT)
    faceTarget(target)

    -- ── Phase 6: Hunter's Grasp (Skill R) — Combo Ender ─────────────────────
    setPhase("6 · Hunter's Grasp [R]")
    task.wait(CFG.HG_CAST_DELAY)
    pressKey(KEYS.SKILL_3, 0.06)
    task.wait(CFG.POST_HG)

    -- ── Phase 7 (optional): Post-HG M1 + Downslam ───────────────────────────
    if CFG.FULL_ENDER then
        setPhase("7 · Ender M1s + Downslam")
        for i = 1, 3 do
            faceTarget(target)
            sx, sy = targetScreenPos(target)
            clickM1(sx, sy)
            task.wait(CFG.M1_INTERVAL)
        end
        -- Downslam: Jump + look-down + M1
        task.spawn(function()
            task.wait(0.05)
            VIM:SendMouseButtonEvent(sx, sy + 120, 0, true,  game, 0)
            task.wait(0.05)
            VIM:SendMouseButtonEvent(sx, sy + 120, 0, false, game, 0)
        end)
        pressKey(KEYS.JUMP, 0.12)
        task.wait(0.35)
    end

    COMBOS_DONE = COMBOS_DONE + 1
    setPhase("✓ Done  (#" .. COMBOS_DONE .. ")")
    COMBO_ACTIVE  = false
    LOCKED_TARGET = nil
end

