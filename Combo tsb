local C = Color3.fromRGB

local function mk(cls, props)
    local i = Instance.new(cls)
    for k, v in pairs(props) do i[k] = v end
    return i
end

local function corner(parent, r)
    local c = Instance.new("UICorner", parent)
    c.CornerRadius = UDim.new(0, r or 10)
end

local function lbl(parent, text, pos, size, fs, fc, xa)
    local L = mk("TextLabel", {
        Text=text, Size=size or UDim2.new(1,-16,0,20),
        Position=pos or UDim2.new(0,8,0,0),
        TextColor3=fc or C(200,200,200),
        BackgroundTransparency=1, Font=Enum.Font.GothamBold,
        TextSize=fs or 12,
        TextXAlignment=xa or Enum.TextXAlignment.Left,
        BorderSizePixel=0, Parent=parent,
    })
    return L
end

local function btn(parent, text, pos, size, bg, tc, fs)
    local B = mk("TextButton", {
        Text=text, Size=size or UDim2.new(0.45,0,0,34),
        Position=pos, BackgroundColor3=bg or C(60,0,120),
        TextColor3=tc or C(255,255,255),
        Font=Enum.Font.GothamBold, TextSize=fs or 13,
        BorderSizePixel=0, Parent=parent,
    })
    corner(B, 8)
    return B
end

