-- ── Panel drag ────────────────────────────────────────────────────────────────
local dragging=false; local dStart; local pStart
header.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.Touch
    or i.UserInputType==Enum.UserInputType.MouseButton1 then
        dragging=true; dStart=i.Position; pStart=panel.Position
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if not dragging then return end
    local d = i.Position - dStart
    panel.Position = UDim2.new(pStart.X.Scale, pStart.X.Offset+d.X,
                                pStart.Y.Scale, pStart.Y.Offset+d.Y)
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.Touch
    or i.UserInputType==Enum.UserInputType.MouseButton1 then
        dragging=false
    end
end)

-- ─── Heartbeat: scanner + status + auto loop ─────────────────────────────────
local scanClock = 0
RunService.Heartbeat:Connect(function(dt)
    scanClock = scanClock + dt
    if scanClock < 0.2 then return end
    scanClock = 0

    -- Update side dash key from dashDir
    -- (read at combo-time, not stored in CFG)

    local target = findNearest()
    if target then
        local tRoot = targetRoot(target)
        local myRoot = getMyRoot()
        local dist = (tRoot and myRoot)
            and math.floor((tRoot.Position - myRoot.Position).Magnitude)
            or 0
        targetLbl.Text = "⊙  " .. (target.DisplayName or target.Name)
        distLbl.Text   = ("Distance: %d studs  |  Combos: %d"):format(dist, COMBOS_DONE)
        targetLbl.TextColor3 = C(80, 255, 120)
    else
        targetLbl.Text = "⊙  No target in range"
        targetLbl.TextColor3 = C(255, 80, 80)
        distLbl.Text   = ("Distance: --  |  Combos: %d"):format(COMBOS_DONE)
    end

    if RUNNING then
        countLbl.Text = ("Auto: ON  |  Combos: %d"):format(COMBOS_DONE)
    else
        countLbl.Text = ("Auto: OFF  |  Combos: %d"):format(COMBOS_DONE)
    end

    -- Auto combo trigger
    if RUNNING and not COMBO_ACTIVE and target then
        -- Dynamic dash direction
        -- (patch the kyotoCombo's dash key based on dashDir)
        task.spawn(function()
            if COMBO_ACTIVE then return end
            -- override dash key momentarily
            local savedDash = CFG._dashKey
            CFG._dashKey = dashDir == "LEFT" and KEYS.LEFT or KEYS.RIGHT
            kyotoCombo()
        end)
    end
end)

