-- ── list builder with inline inputs ──────────────────────────────────────────

local function buildList(search,cat)
    for _,c in ipairs(cmdCards) do c:Destroy() end
    cmdCards={}
    local results={}
    for _,v in pairs(Commands) do
        local matchCat=cat=="All" or v.cat==cat
        local matchSearch=search=="" or v.name:lower():find(search:lower()) or v.desc:lower():find(search:lower())
        if matchCat and matchSearch then table.insert(results,v) end
    end
    table.sort(results,function(a,b) return a.name<b.name end)
    countLbl.Text=#results.." / "..#(function() local t={} for k in pairs(Commands) do t[#t+1]=k end return t end()).." cmds"

    for i,cmd in ipairs(results) do
        local hasArgs=#cmd.args>0
        local cardH=hasArgs and 44+28*#cmd.args or 44

        local card=Instance.new("Frame")
        card.Size=UDim2.new(1,-6,0,cardH)
        card.BackgroundColor3=Color3.fromRGB(16,16,24)
        card.BorderSizePixel=0
        card.LayoutOrder=i
        card.Parent=list
        Instance.new("UICorner",card).CornerRadius=UDim.new(0,8)

        local dot=Instance.new("Frame")
        dot.Size=UDim2.new(0,3,0,18)
        dot.Position=UDim2.new(0,6,0,13)
        dot.BackgroundColor3=catColors[cmd.cat] or Color3.fromRGB(100,100,100)
        dot.BorderSizePixel=0
        dot.Parent=card
        Instance.new("UICorner",dot).CornerRadius=UDim.new(1,0)

        local nl=Instance.new("TextLabel")
        nl.Size=UDim2.new(0.55,0,0,20)
        nl.Position=UDim2.new(0,16,0,4)
        nl.BackgroundTransparency=1
        nl.Text=";"..cmd.name
        nl.TextColor3=Color3.fromRGB(225,225,240)
        nl.TextSize=12
        nl.Font=Enum.Font.GothamBold
        nl.TextXAlignment=Enum.TextXAlignment.Left
        nl.Parent=card

        local dl=Instance.new("TextLabel")
        dl.Size=UDim2.new(0.65,0,0,16)
        dl.Position=UDim2.new(0,16,0,22)
        dl.BackgroundTransparency=1
        dl.Text=cmd.desc
        dl.TextColor3=Color3.fromRGB(80,80,105)
        dl.TextSize=10
        dl.Font=Enum.Font.Gotham
        dl.TextXAlignment=Enum.TextXAlignment.Left
        dl.Parent=card

        -- number inputs
        local inputValues={}
        for ai,arg in ipairs(cmd.args) do
            inputValues[ai]=arg.default

            local inputRow=Instance.new("Frame")
            inputRow.Size=UDim2.new(1,-16,0,24)
            inputRow.Position=UDim2.new(0,8,0,42+(ai-1)*28)
            inputRow.BackgroundColor3=Color3.fromRGB(12,12,18)
            inputRow.BorderSizePixel=0
            inputRow.Parent=card
            Instance.new("UICorner",inputRow).CornerRadius=UDim.new(0,5)

            local argLabel=Instance.new("TextLabel")
            argLabel.Size=UDim2.new(0,60,1,0)
            argLabel.BackgroundTransparency=1
            argLabel.Text=arg.name
            argLabel.TextColor3=Color3.fromRGB(140,140,170)
            argLabel.TextSize=10
            argLabel.Font=Enum.Font.GothamBold
            argLabel.Parent=inputRow

            local minBtn=Instance.new("TextButton")
            minBtn.Size=UDim2.new(0,22,0,22)
            minBtn.Position=UDim2.new(0,62,0.5,-11)
            minBtn.BackgroundColor3=Color3.fromRGB(28,28,40)
            minBtn.BorderSizePixel=0
            minBtn.Text="-"
            minBtn.TextColor3=Color3.fromRGB(200,200,220)
            minBtn.TextSize=14
            minBtn.Font=Enum.Font.GothamBold
            minBtn.Parent=inputRow
            Instance.new("UICorner",minBtn).CornerRadius=UDim.new(0,4)

            local valBox=Instance.new("TextBox")
            valBox.Size=UDim2.new(0,70,0,22)
            valBox.Position=UDim2.new(0,88,0.5,-11)
            valBox.BackgroundColor3=Color3.fromRGB(22,22,34)
            valBox.BorderSizePixel=0
            valBox.Text=tostring(arg.default)
            valBox.TextColor3=Color3.fromRGB(220,220,240)
            valBox.TextSize=11
            valBox.Font=Enum.Font.GothamBold
            valBox.ClearTextOnFocus=false
            valBox.Parent=inputRow
            Instance.new("UICorner",valBox).CornerRadius=UDim.new(0,4)

            local plusBtn=Instance.new("TextButton")
            plusBtn.Size=UDim2.new(0,22,0,22)
            plusBtn.Position=UDim2.new(0,162,0.5,-11)
            plusBtn.BackgroundColor3=Color3.fromRGB(28,28,40)
            plusBtn.BorderSizePixel=0
            plusBtn.Text="+"
            plusBtn.TextColor3=Color3.fromRGB(200,200,220)
            plusBtn.TextSize=14
            plusBtn.Font=Enum.Font.GothamBold
            plusBtn.Parent=inputRow
            Instance.new("UICorner",plusBtn).CornerRadius=UDim.new(0,4)

            local rangeLabel=Instance.new("TextLabel")
            rangeLabel.Size=UDim2.new(0,80,1,0)
            rangeLabel.Position=UDim2.new(0,188,0,0)
            rangeLabel.BackgroundTransparency=1
            rangeLabel.Text=arg.min.."-"..arg.max
            rangeLabel.TextColor3=Color3.fromRGB(55,55,75)
            rangeLabel.TextSize=9
            rangeLabel.Font=Enum.Font.Gotham
            rangeLabel.Parent=inputRow

            local step=math.max(1,math.floor((arg.max-arg.min)/100))

            local function updateVal(newVal)
                newVal=math.clamp(tonumber(newVal) or inputValues[ai], arg.min, arg.max)
                -- round to int if step>=1
                if step>=1 then newVal=math.floor(newVal) end
                inputValues[ai]=newVal
                valBox.Text=tostring(newVal)
            end

            minBtn.MouseButton1Click:Connect(function() updateVal(inputValues[ai]-step) end)
            plusBtn.MouseButton1Click:Connect(function() updateVal(inputValues[ai]+step) end)
            valBox.FocusLost:Connect(function() updateVal(valBox.Text) end)
        end

        local rb=Instance.new("TextButton")
        rb.Size=UDim2.new(0,52,0,22)
        rb.Position=UDim2.new(1,-60,0,11)
        rb.BackgroundColor3=Color3.fromRGB(28,28,180)
        rb.BorderSizePixel=0
        rb.Text="RUN"
        rb.TextColor3=Color3.fromRGB(190,190,255)
        rb.TextSize=11
        rb.Font=Enum.Font.GothamBold
        rb.Parent=card
        Instance.new("UICorner",rb).CornerRadius=UDim.new(0,6)

        rb.MouseButton1Click:Connect(function()
            pcall(function() cmd.fn(table.unpack(inputValues)) end)
            TweenService:Create(rb,TweenInfo.new(0.08),{BackgroundColor3=Color3.fromRGB(60,60,255)}):Play()
            task.delay(0.15,function() TweenService:Create(rb,TweenInfo.new(0.08),{BackgroundColor3=Color3.fromRGB(28,28,180)}):Play() end)
        end)

        table.insert(cmdCards,card)
    end
end

