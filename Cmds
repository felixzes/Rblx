-- chat parser
lp.Chatted:Connect(function(msg)
    if msg:sub(1,1)~=";" then return end
    local parts={} for w in msg:sub(2):gmatch("%S+") do table.insert(parts,w) end
    if #parts==0 then return end
    local cmd=Commands[parts[1]:lower()]
    if cmd then
        -- for chat commands pass string args directly to fn that expects them
        pcall(function() cmd.fn(table.unpack(parts,2)) end)
    else notify("CMD","Unknown: ;"..parts[1]) end
end)

