local Commands={}

-- args: list of {name, default, min, max} for number inputs
-- if args is nil, no inputs shown
local function reg(name,desc,cat,args,fn)
    Commands[name:lower()]={name=name,desc=desc,cat=cat,args=args or {},fn=fn}
end

