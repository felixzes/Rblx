reg("follow","Follow player ;follow name","Player",function(a)
	clearConn("follow")
	if not a then return end
	Connections["follow"]=RunService.Heartbeat:Connect(function()
		for _,p in ipairs(Players:GetPlayers()) do
			if p.Name:lower():find(a:lower()) and p~=lp then
				local tHRP=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				local hrp=getHRP()
				local hum=getHum()
				if tHRP and hrp and hum then
					local dir=(tHRP.Position-hrp.Position)
					if dir.Magnitude>5 then hum:MoveTo(tHRP.Position) end
				end
			end
		end
	end)
	notify("Follow","Following "..a)
