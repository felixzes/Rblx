reg("camlock","Toggle camlock","Player",function()
	State.camlock=not State.camlock
	if State.camlock then
		local nearest,nd=nil,math.huge
		local myHRP=getHRP() if not myHRP then return end
		for _,p in ipairs(Players:GetPlayers()) do
			if p==lp then continue end
			local hrp=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if hrp then local d=(hrp.Position-myHRP.Position).Magnitude if d<nd then nd=d nearest=p end end
		end
		if nearest then
			Connections["camlock"]=RunService.RenderStepped:Connect(function()
				if not State.camlock then return end
				local tHRP=nearest.Character and nearest.Character:FindFirstChild("HumanoidRootPart")
				if tHRP then cam.CFrame=CFrame.new(cam.CFrame.Position,tHRP.CFrame*CFrame.new(0,2,2).Position) end
			end)
			notify("Camlock","→ "..nearest.Name)
		end
	else clearConn("camlock") cam.CameraType=Enum.CameraType.Custom notify("Camlock","Off") end
end)
