local Connections = {}
local function clearConn(k) if Connections[k] then pcall(function() Connections[k]:Disconnect() end) Connections[k]=nil end end
local function getChar() return lp.Character end
local function getHum() local c=getChar() return c and c:FindFirstChildOfClass("Humanoid") end
local function getHRP() local c=getChar() return c and c:FindFirstChild("HumanoidRootPart") end

local function notify(t,b)
	pcall(function()
		StarterGui:SetCore("SendNotification",{Title=t or"CMD",Text=tostring(b or""),Duration=2})
	end)
end

-- ── fly ──────────────────────────────────────────────────────────────────────

local flyConn,flyBV,flyAtt

local function startFly()
	local hrp=getHRP() local hum=getHum()
	if not hrp or not hum then return end
	State.fly=true
	hum.PlatformStand=true
	flyAtt=Instance.new("Attachment",hrp)
	flyBV=Instance.new("LinearVelocity",hrp)
	flyBV.Attachment0=flyAtt
	flyBV.MaxForce=1e6
	flyBV.VectorVelocity=Vector3.zero
	flyBV.RelativeTo=Enum.ActuatorRelativeTo.World
	flyConn=RunService.Heartbeat:Connect(function()
		if not State.fly then return end
		local hrp2=getHRP() if not hrp2 then return end
		local cf=cam.CFrame
		local vel=Vector3.zero
		local spd=State.flySpeed
		if UIS:IsKeyDown(Enum.KeyCode.W) then vel=vel+cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then vel=vel-cf.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then vel=vel-cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then vel=vel+cf.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then vel=vel+Vector3.new(0,1,0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then vel=vel-Vector3.new(0,1,0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then spd=spd*2.5 end
		local md=getHum() and getHum().MoveDirection or Vector3.zero
		if md.Magnitude>0.1 then vel=vel+Vector3.new(md.X,0,md.Z) end
		flyBV.VectorVelocity=vel.Magnitude>0 and vel.Unit*spd or Vector3.zero
	end)
end

local function stopFly()
	State.fly=false
	if flyConn then flyConn:Disconnect() flyConn=nil end
	if flyBV then flyBV:Destroy() flyBV=nil end
	if flyAtt then flyAtt:Destroy() flyAtt=nil end
	local hum=getHum() if hum then hum.PlatformStand=false end
end

-- ── systems ──────────────────────────────────────────────────────────────────

local function startNoclip()
	State.noclip=true
	Connections["noclip"]=RunService.Stepped:Connect(function()
		local c=getChar() if not c then return end
		for _,p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false end end
	end)
end
local function stopNoclip()
	State.noclip=false clearConn("noclip")
	local c=getChar() if not c then return end
	for _,p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=true end end
end

local function startGod()
	State.godmode=true
	Connections["god"]=RunService.Heartbeat:Connect(function()
		local h=getHum() if h then h.Health=h.MaxHealth end
	end)
end
local function stopGod() State.godmode=false clearConn("god") end

local espBoxes={}
local function clearESP() for _,v in pairs(espBoxes) do pcall(function() v:Destroy() end) end espBoxes={} end
local function startESP()
	State.esp=true clearESP()
	for _,p in ipairs(Players:GetPlayers()) do
		if p==lp then continue end
		local c=p.Character if not c then continue end
		local bb=Instance.new("SelectionBox")
		bb.Adornee=c bb.Color3=Color3.fromRGB(255,50,50)
		bb.LineThickness=0.05 bb.SurfaceTransparency=0.8
		bb.SurfaceColor3=Color3.fromRGB(255,50,50)
		bb.Parent=workspace espBoxes[p.Name]=bb
	end
end
local function stopESP() State.esp=false clearESP() end

local function startAutoheal()
	State.autoheal=true
	Connections["autoheal"]=RunService.Heartbeat:Connect(function()
		local h=getHum() if h and h.Health<h.MaxHealth then h.Health=math.min(h.Health+2,h.MaxHealth) end
	end)
end
local function stopAutoheal() State.autoheal=false clearConn("autoheal") end

local function startInfJump()
	State.inf_jump=true
	Connections["infjump"]=UIS.JumpRequest:Connect(function()
		local h=getHum() if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
	end)
end
local function stopInfJump() State.inf_jump=false clearConn("infjump") end

local function startSpin()
	State.spinActive=true
	Connections["spin"]=RunService.Heartbeat:Connect(function()
		local hrp=getHRP() if hrp then hrp.CFrame=hrp.CFrame*CFrame.Angles(0,math.rad(10),0) end
	end)
end
local function stopSpin() State.spinActive=false clearConn("spin") end

local rainbowHue=0
local function startRainbow()
	State.rainbow=true
	Connections["rainbow"]=RunService.Heartbeat:Connect(function()
		rainbowHue=(rainbowHue+0.002)%1
		local c=getChar() if not c then return end
		for _,p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.Color=Color3.fromHSV(rainbowHue,1,1) end end
	end)
end
local function stopRainbow() State.rainbow=false clearConn("rainbow") end

local origAmbient,origOutdoor
local function startFullbright()
	origAmbient=Lighting.Ambient origOutdoor=Lighting.OutdoorAmbient
	Lighting.Ambient=Color3.fromRGB(255,255,255)
	Lighting.OutdoorAmbient=Color3.fromRGB(255,255,255)
	Lighting.Brightness=10 State.fullbright=true
end
local function stopFullbright()
	if origAmbient then Lighting.Ambient=origAmbient end
	if origOutdoor then Lighting.OutdoorAmbient=origOutdoor end
	Lighting.Brightness=1 State.fullbright=false
end

local function startAntiRagdoll()
	State.antiRagdoll=true
	Connections["antirag"]=RunService.Heartbeat:Connect(function()
		local c=getChar() local hum=getHum() if not c or not hum then return end
		for _,d in ipairs(c:GetDescendants()) do if d:IsA("Motor6D") and not d.Enabled then d.Enabled=true end end
		if hum.PlatformStand then hum.PlatformStand=false end
		local s=hum:GetState()
		if s==Enum.HumanoidStateType.Ragdoll or s==Enum.HumanoidStateType.FallingDown then
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end
local function stopAntiRagdoll() State.antiRagdoll=false clearConn("antirag") end

local function startAntiStun()
	State.antiStun=true
	Connections["antistun"]=RunService.Heartbeat:Connect(function()
		local hum=getHum() if not hum then return end
		if hum.WalkSpeed<State.speed then hum.WalkSpeed=State.speed end
		if hum.PlatformStand then hum.PlatformStand=false end
		if hum.Sit then hum.Sit=false end
	end)
end
local function stopAntiStun() State.antiStun=false clearConn("antistun") end

local function startClickTP()
	State.clicktp=true
	Connections["clicktp"]=mouse.Button1Down:Connect(function()
		if not State.clicktp then return end
		local hrp=getHRP()
		if hrp and mouse.Target then hrp.CFrame=CFrame.new(mouse.Hit.Position+Vector3.new(0,3,0)) end
	end)
end
local function stopClickTP() State.clicktp=false clearConn("clicktp") end

local origFogEnd
local function startNoFog() origFogEnd=Lighting.FogEnd Lighting.FogEnd=1e6 State.noFog=true end
local function stopNoFog() if origFogEnd then Lighting.FogEnd=origFogEnd end State.noFog=false end

local function startInvis()
	State.invisible=true
	local c=getChar() if not c then return end
	for _,p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then p.LocalTransparencyModifier=1 end
		if p:IsA("Decal") then p.Transparency=1 end
	end
end
local function stopInvis()
	State.invisible=false
	local c=getChar() if not c then return end
	for _,p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") then p.LocalTransparencyModifier=0 end
		if p:IsA("Decal") then p.Transparency=0 end
	end
end

local function tpToPlayer(name)
	for _,p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():find(name:lower()) and p~=lp then
			local hrp=getHRP() local tHRP=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if hrp and tHRP then hrp.CFrame=tHRP.CFrame+Vector3.new(3,0,0) notify("TP","→ "..p.Name) return end
		end
	end
end

local function bringPlayer(name)
	for _,p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():find(name:lower()) and p~=lp then
			local hrp=getHRP() local tHRP=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if hrp and tHRP then tHRP.CFrame=hrp.CFrame+Vector3.new(3,0,0) notify("Bring",p.Name) return end
		end
	end
end

local function flingPlayer(name)
	for _,p in ipairs(Players:GetPlayers()) do
		if p.Name:lower():find(name:lower()) and p~=lp then
			local tHRP=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if tHRP then tHRP.AssemblyLinearVelocity=Vector3.new(math.random(-200,200),500,math.random(-200,200)) notify("Fling",p.Name) return end
		end
	end
end

