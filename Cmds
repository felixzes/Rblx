local function filterCmds(search, cat)
	local results = {}
	for k, v in pairs(Commands) do
		local matchCat = cat == "All" or v.cat == cat
		local matchSearch = search == "" or k:find(search:lower()) or v.desc:lower():find(search:lower())
		if matchCat and matchSearch then
			table.insert(results, v)
		end
	end
	table.sort(results, function(a,b) return a.name < b.name end)
	return results
end

