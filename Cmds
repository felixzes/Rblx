reg("camlock","Toggle camlock nearest","Player",function()
	State.camlock=not State.camlock
	if State.camlock then
		clearConn("camlock")
		local nearest=nil
		local myHRP=getHRP()
		if not myHRP then return end
		local nearestDist=math.huge
		for _,p in ipairs(Players:GetPlayers()) do
			if p==lp then continue end
			local hrp=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if hrp then local d=(hrp.Position-myHRP.Position).Magnitude if d<nearestDist then nearestDist=d nearest=p end end
		end
		if nearest then
			cam.CameraType=Enum.CameraType.Custom
			Connections["camlock"]=RunService.RenderStepped:Connect(function()
				if not State.camlock then return end
				local tHRP=nearest.Character and nearest.Character:FindFirstChild("HumanoidRootPart")
				if tHRP then
					local back=tHRP.CFrame*CFrame.new(0,2,3)
					cam.CFrame=CFrame.new(cam.CFrame.Position,(back.Position))
				end
			end)
			notify("Camlock","→ "..nearest.Name)
		end
	else
		clearConn("camlock")
		cam.CameraType=Enum.CameraType.Custom
		notify("Camlock","Off")
	end
end)

