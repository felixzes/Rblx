local logCount = 0
logAdd = function(txt)
    logCount = logCount + 1
    local L=Instance.new("TextLabel")
    L.Size=UDim2.new(1,0,0,13); L.BackgroundTransparency=1
    L.Text=txt; L.TextColor3=Color3.fromRGB(140,200,140); L.TextSize=9
    L.Font=Enum.Font.Code; L.TextXAlignment=Enum.TextXAlignment.Left
    L.LayoutOrder=logCount; L.ZIndex=4; L.Parent=logFrame
    -- keep scroll at bottom
    task.defer(function()
        logFrame.CanvasPosition=Vector2.new(0,logFrame.AbsoluteCanvasSize.Y)
    end)
    -- cap log at 40 lines
    local kids=logFrame:GetChildren()
    local lines={}
    for _,k in ipairs(kids) do if k:IsA("TextLabel") then table.insert(lines,k) end end
    if #lines>40 then lines[1]:Destroy() end
end

