--[[
    chatfly.lua
    :fly <name>     — makes target fly (BodyVelocity + BodyGyro forced on their character)
    :land <name>    — removes fly from target
    :flyall         — flies everyone
    :landall        — lands everyone
    works by writing movers into the target's character parts via network ownership claim
]]

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TextChatService  = game:GetService("TextChatService")
local Workspace        = game:GetService("Workspace")

local LP = Players.LocalPlayer

-- ─── state ───────────────────────────────────────
local flying = {}   -- player → { bv, bg, conn }

-- ─── network claim ───────────────────────────────
local function claimParts(char)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            pcall(function()
                p:SetNetworkOwner(LP)
                sethiddenproperty(LP, "SimulationRadius",    2147483647)
                sethiddenproperty(LP, "MaxSimulationRadius", 2147483647)
            end)
        end
    end
    LP.ReplicationFocus = Workspace
end

-- ─── fly on a player ─────────────────────────────
local function startFly(p)
    if flying[p] then return end
    local char = p.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")

    claimParts(char)

    -- suppress gravity
    if hum then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,  false)
        end)
    end

    local bv = Instance.new("BodyVelocity")
    bv.Velocity  = Vector3.new(0, 30, 0)   -- launch upward first
    bv.MaxForce  = Vector3.new(0, 1e6, 0)
    bv.P         = 1e4
    bv.Parent    = hrp

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P         = 1e4
    bg.D         = 500
    bg.CFrame    = hrp.CFrame
    bg.Parent    = hrp

    -- after launch, switch to hover
    task.delay(0.6, function()
        if not flying[p] then return end
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.MaxForce = Vector3.new(0, 1e9, 0)
    end)

    -- heartbeat: re-enforce ownership + keep them floating
    local conn = RunService.Heartbeat:Connect(function()
        if not flying[p] then return end
        local c = p.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        -- re-enforce network ownership every frame
        pcall(function() h:SetNetworkOwner(LP) end)
        -- keep vertical velocity nulled so they hover
        if bv and bv.Parent then
            bv.MaxForce = Vector3.new(0, 1e9, 0)
            -- if they have no vertical motion keep them locked
            if math.abs(h.Velocity.Y) < 2 then
                bv.Velocity = Vector3.new(0, 0, 0)
            end
        end
    end)

    flying[p] = { bv = bv, bg = bg, conn = conn }
end

local function stopFly(p)
    local data = flying[p]
    if not data then return end
    flying[p] = nil
    data.conn:Disconnect()
    if data.bv and data.bv.Parent then data.bv:Destroy() end
    if data.bg and data.bg.Parent then data.bg:Destroy() end
    local char = p.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,  true)
            end)
        end
    end
end

local function flyAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then startFly(p) end
    end
end

local function landAll()
    for _, p in ipairs(Players:GetPlayers()) do
        stopFly(p)
    end
end

-- ─── name resolve (partial match) ────────────────
local function resolvePlayer(name)
    name = name:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == name then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #name) == name then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(name, 1, true) then return p end
    end
    return nil
end

-- ─── chat hook ───────────────────────────────────
local function handleMsg(text)
    text = text:match("^%s*(.-)%s*$")  -- trim
    local cmd, arg = text:match("^:(%S+)%s*(.*)")
    if not cmd then return end
    cmd = cmd:lower()
    arg = arg and arg:match("^%s*(.-)%s*$") or ""

    if cmd == "fly" then
        if arg == "" then
            notify("❌", ":fly requires a username")
            return
        end
        local p = resolvePlayer(arg)
        if not p then notify("❌", "player not found: "..arg); return end
        startFly(p)
        notify("✈", "flying "..p.Name)

    elseif cmd == "land" then
        if arg == "" then
            notify("❌", ":land requires a username")
            return
        end
        local p = resolvePlayer(arg)
        if not p then notify("❌", "player not found: "..arg); return end
        stopFly(p)
        notify("🛬", "landed "..p.Name)

    elseif cmd == "flyall" then
        flyAll()
        notify("✈", "flying all players")

    elseif cmd == "landall" then
        landAll()
        notify("🛬", "landed all players")

    elseif cmd == "flyhelp" then
        notify("📖", ":fly <name>  :land <name>  :flyall  :landall")
    end
end

-- ─── notification helper ─────────────────────────
-- defined after handleMsg since it's a forward ref
notify = function(icon, msg)
    local StarterGui = game:GetService("StarterGui")
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title    = icon .. " chatfly",
            Text     = msg,
            Duration = 3,
        })
    end)
    -- also print to the GUI log (built below)
    if logAdd then logAdd(icon.." "..msg) end
end

-- ─── chat intercept ──────────────────────────────
-- works on both legacy and new TextChatService
local function hookChat()
    -- new chat
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local ch = TextChatService:FindFirstChild("TextChannels")
            and TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if ch then
            -- intercept before send: use a TextChannel:SendAsync wrapper
            -- hook via MessageReceived on the local player's outgoing messages
            TextChatService.SendingMessage:Connect(function(msg)
                local txt = msg.Text
                if txt:sub(1,1) == ":" then
                    handleMsg(txt)
                end
            end)
        end
        -- also hook via MessageReceived for messages from self
        TextChatService.MessageReceived:Connect(function(msg)
            if msg.TextSource and msg.TextSource.UserId == LP.UserId then
                local txt = msg.Text
                if txt:sub(1,1) == ":" then
                    handleMsg(txt)
                end
            end
        end)
    else
        -- legacy chat
        local ok, chatGui = pcall(function()
            return LP.PlayerGui:WaitForChild("Chat", 5)
        end)
        if ok and chatGui then
            pcall(function()
                local frame = chatGui:FindFirstChild("Frame")
                local chatBar = frame and frame:FindFirstChildWhichIsA("TextBox", true)
                if chatBar then
                    chatBar.FocusLost:Connect(function(enter)
                        if enter then
                            local txt = chatBar.Text
                            if txt:sub(1,1) == ":" then
                                handleMsg(txt)
                            end
                        end
                    end)
                end
            end)
        end
        -- fallback: hook via chat event
        pcall(function()
            local re = game:GetService("ReplicatedStorage")
                :FindFirstChild("DefaultChatSystemChatEvents")
            if re then
                local sayMsg = re:FindFirstChild("SayMessageRequest")
                if sayMsg then
                    -- we can't hook FireServer but we can listen for the GUI box
                end
            end
        end)
    end
end

hookChat()

-- also intercept via a raw UserInputService hook on Enter key as fallback
-- reads the chat box text directly
local function rawChatHook()
    UserInputService.InputBegan:Connect(function(input, gpe)
        if input.KeyCode ~= Enum.KeyCode.Return and input.KeyCode ~= Enum.KeyCode.KeypadEnter then return end
        -- find active TextBox
        local focused = UserInputService:GetFocusedTextBox()
        if not focused then return end
        local txt = focused.Text
        if txt and txt:sub(1,1) == ":" then
            handleMsg(txt)
        end
    end)
end
rawChatHook()

-- ─── cleanup on player leave ─────────────────────
Players.PlayerRemoving:Connect(function(p)
    stopFly(p)
end)

