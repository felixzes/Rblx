local rebirthLbl = mkLabel(panel, "Rebirths: 0 / 89,020",
    UDim2.new(0,8,0,36), UDim2.new(1,-16,0,22),
    14, Color3.fromRGB(210,100,255))

local levelLbl = mkLabel(panel, "Level: 0  |  Need: 50  |  Session: +0",
    UDim2.new(0,8,0,58), UDim2.new(1,-16,0,20),
    12, Color3.fromRGB(80,200,255))

-- Progress bar
local barBg = mkFrame(panel,
