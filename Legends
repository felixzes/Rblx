-- Panel drag
local dragging=false; local dragStart; local startPos
header.InputBegan:Connect(function(inp)
    if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
        dragging=true; dragStart=inp.Position; startPos=panel.Position
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(inp)
    if dragging then
        local delta=inp.Position-dragStart
        panel.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
    end
end)
game:GetService("UserInputService").InputEnded:Connect(function(inp)
    if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
        dragging=false
    end
end)

-- ─── All known orb types × zones ─────────────────────────────────────────────
-- Burst-fires every frame — server rate-limits per player, but multi-type helps
local ORB_ARGS = {
    {"collectOrb", "Yellow Orb",  "City"},
    {"collectOrb", "Red Orb",     "City"},
    {"collectOrb", "Blue Orb",    "City"},
    {"collectOrb", "Green Orb",   "City"},
    {"collectOrb", "Purple Orb",  "City"},
    {"collectOrb", "Orange Orb",  "City"},
    {"collectOrb", "Gem",         "City"},
    {"collectOrb", "Yellow Orb",  "Forest"},
    {"collectOrb", "Red Orb",     "Forest"},
    {"collectOrb", "Blue Orb",    "Forest"},
    {"collectOrb", "Gem",         "Forest"},
    {"collectOrb", "Yellow Orb",  "Beach"},
    {"collectOrb", "Red Orb",     "Beach"},
    {"collectOrb", "Gem",         "Beach"},
}

-- ─── Method 1: firetouchinterest on all Hoops (fastest legit step method) ─────
local steppedConn
steppedConn = RunService.Stepped:Connect(function()
    if not RUNNING then steppedConn:Disconnect(); return end
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hoopFolder = workspace:FindFirstChild("Hoops")
    if not hoopFolder then return end
    for _, hoop in next, hoopFolder:GetChildren() do
        pcall(function()
            firetouchinterest(hrp, hoop, 0)
            firetouchinterest(hrp, hoop, 1)
        end)
    end
end)

-- ─── Method 2: orbEvent burst (multi-type, max rate) ─────────────────────────
task.spawn(function()
    while RUNNING do
        for _, args in ipairs(ORB_ARGS) do
            for _=1, ORB_BURST do
                pcall(function()
                    orbEvent:FireServer(table.unpack(args))
                end)
            end
        end
        task.wait()  -- yield one frame between bursts
    end
end)

-- ─── Method 3: rebirthEvent spam ─────────────────────────────────────────────
-- Server checks level — fires constantly so rebirth triggers the instant we qualify
task.spawn(function()
    while RUNNING do
        pcall(function()
            rebirthEvent:FireServer("rebirthRequest")
        end)
        task.wait(REBIRTH_RATE)
    end
end)

-- ─── UI + session tracker ─────────────────────────────────────────────────────
local sessionStart = getRebirths()
local startTime    = os.time()

task.spawn(function()
    while RUNNING do
        local current  = getRebirths()
        local lv       = getLevel()
        local need     = getRebirthLevelReq()
        local session  = current - sessionStart
        local pct      = math.clamp(current / TARGET, 0, 1)
        local elapsed  = os.time() - startTime
        local rate     = elapsed > 0 and (session / elapsed * 3600) or 0  -- per hour

        -- Labels
        rebirthLbl.Text = ("Rebirths: %d / %d"):format(current, TARGET)
        levelLbl.Text   = ("Level: %d  |  Need: %d  |  Session: +%d  [%.0f/hr]"):format(
            lv, need, session, rate)
        pctLbl.Text     = ("%.4f%%  complete"):format(pct * 100)

        -- Progress bar
        barFill.Size = UDim2.new(pct, 0, 1, 0)
        barFill.BackgroundColor3 = Color3.fromHSV(0.78 - (pct * 0.78), 1, 1)

        if current >= TARGET then
            RUNNING = false
            statusLbl.Text = "✅  89,020 REBIRTHS REACHED!"
            statusLbl.TextColor3 = Color3.fromRGB(255, 255, 0)
            rebirthLbl.TextColor3 = Color3.fromRGB(255, 255, 0)
            pcall(function()
                StarterGui:SetCore("SendNotification",{
                    Title="RebirthFarmer",Text="89,020 rebirths reached!",Duration=10
                })
            end)
        else
            local farming = lv >= need and "◉ Rebirthing..." or
                            ("◉ Farming steps... (%d / %d)"):format(lv, need)
            statusLbl.Text = farming
        end

        task.wait(0.3)
    end
end)

