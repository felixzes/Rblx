--[[
    Legends of Speed — 89020 Rebirth Farmer
    Methods: firetouchinterest hoops + orbEvent spam + rebirthEvent loop
    Engine: executor environment (firetouchinterest required)
    Target: 89,020 rebirths
]]

-- ─── Services ────────────────────────────────────────────────────────────────
local Players     = game:GetService("Players")
local RunService  = game:GetService("RunService")
local RepStorage  = game:GetService("ReplicatedStorage")
local StarterGui  = game:GetService("StarterGui")
local VirtualUser = game:GetService("VirtualUser")

local Player      = Players.LocalPlayer
local rEvents     = RepStorage:WaitForChild("rEvents", 10)

if not rEvents then
    warn("[RebirthFarmer] rEvents not found — wrong game?"); return
end

local rebirthEvent = rEvents:WaitForChild("rebirthEvent", 10)
local orbEvent     = rEvents:WaitForChild("orbEvent", 10)

-- ─── Config ──────────────────────────────────────────────────────────────────
local TARGET         = 89020
local ORB_BURST      = 25      -- orb fires per frame (tune down if kicked)
local REBIRTH_RATE   = 0.05    -- rebirth attempt interval (seconds)
local RUNNING        = true

-- ─── Player stat readers (game uses IntValues on Player) ─────────────────────
local function getVal(names)
    for _, n in ipairs(names) do
        local v = Player:FindFirstChild(n)
        if v and v.Value then return v.Value end
    end
    return 0
end

local function getLevel()
    return getVal({"level","Level","Steps","steps","xp","XP"})
end

local function getRebirths()
    return getVal({"rebirths","Rebirths","rebirthCount","RebirthCount","totalRebirths"})
end

local function getRebirthLevelReq()
    -- wiki formula: starts at 50, +25 per rebirth
    return 50 + (getRebirths() * 25)
end

-- ─── Anti-AFK ────────────────────────────────────────────────────────────────
Player.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

-- ─── GUI ─────────────────────────────────────────────────────────────────────
local gui = Instance.new("ScreenGui")
gui.Name            = "LOSRebirthFarm"
gui.ResetOnSpawn    = false
gui.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling
gui.Parent          = Player:WaitForChild("PlayerGui")

local function mkFrame(parent, size, pos, bg, bgT, r)
    local f = Instance.new("Frame")
    f.Size=size; f.Position=pos or UDim2.new(0,0,0,0)
    f.BackgroundColor3=bg or Color3.fromRGB(15,5,20)
    f.BackgroundTransparency=bgT or 0
    f.BorderSizePixel=0; f.Parent=parent
    if r then Instance.new("UICorner",f).CornerRadius=UDim.new(0,r) end
    return f
end

local function mkLabel(parent, text, pos, size, fs, fc, align)
    local L = Instance.new("TextLabel")
    L.Text=text; L.Size=size or UDim2.new(1,0,0,22)
    L.Position=pos or UDim2.new(0,0,0,0)
    L.TextColor3=fc or Color3.fromRGB(255,255,255)
    L.BackgroundTransparency=1; L.Font=Enum.Font.GothamBold
    L.TextSize=fs or 13; L.BorderSizePixel=0
    L.TextXAlignment=align or Enum.TextXAlignment.Left
    L.Parent=parent; return L
end

-- Main panel (draggable)
