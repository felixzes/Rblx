-- update knob visibility based on state
RunService.Heartbeat:Connect(function()
    aimPad.BackgroundTransparency=state==STATE.MERGED and 0.35 or 0.70
    aimKnob.BackgroundTransparency=state==STATE.MERGED and 0.05 or 0.60
end)

local AIM_RADIUS=46
local function clamp2(v,r) local m=v.Magnitude; return m>r and v/m*r or v end

aimPad.InputBegan:Connect(function(inp)
    if state~=STATE.MERGED then return end
    if (inp.UserInputType==Enum.UserInputType.Touch
    or  inp.UserInputType==Enum.UserInputType.MouseButton1) and not aimActive then
        aimActive=true; aimTouch=inp
        aimDelta=Vector2.zero
    end
end)

UserInputService.InputChanged:Connect(function(inp)
    if not aimActive or inp~=aimTouch then return end
    if inp.UserInputType~=Enum.UserInputType.Touch
    and inp.UserInputType~=Enum.UserInputType.MouseMovement then return end
    -- delta from pad center
    local padAbsPos=aimPad.AbsolutePosition
    local padCenter=padAbsPos+aimPad.AbsoluteSize*0.5
    local raw=Vector2.new(inp.Position.X,inp.Position.Y)-padCenter
    local clamped=clamp2(raw,AIM_RADIUS)
    aimDelta=clamped
    aimKnob.Position=UDim2.new(0.5,clamped.X-20,0.5,clamped.Y-20)
end)

UserInputService.InputEnded:Connect(function(inp)
    if inp==aimTouch then
        aimActive=false; aimTouch=nil; aimDelta=Vector2.zero
        aimKnob.Position=UDim2.new(0.5,-20,0.5,-20)
    end
end)

