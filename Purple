    local mode=i%6; local x,z
    if mode<2 then local side=(i%2==0)and 1 or -1; x=side*(hw*.94+jt(i,24)*.4); z=jt(i,25)*hd*.35
    elseif mode<4 then x=jt(i,26)*hw*.70; z=(i%2==0 and 1 or -1)*(hd*.82+jt(i,27)*.10)
    else local a=2*math.pi*i/PHI; local r=math.sqrt(((i-1)%8+.5)/8); x=r*hw*math.cos(a); z=r*hd*math.sin(a) end
    table.insert(TARGETS,{x=x,y=y,z=z})
end
for i=1,14 do local lt=(i-1)/13; local y=44+lt*12; local hw,hd=bp(y); table.insert(TARGETS,{x=jt(i,28)*hw*.55,y=y,z=hd*.70+jt(i,29)*hd*.25}) end
for i=1,16 do local lt=(i-1)/15; local y=54+lt*4; local hw,hd=bp(y); if hw<.03 then hw=.03 end; local a=2*math.pi*i/PHI; local r=math.sqrt((i-.5)/16); table.insert(TARGETS,{x=r*hw*math.cos(a),y=y,z=r*hd*math.sin(a)}) end
for i=1,8  do local lt=(i-1)/7; local y=58+lt*2; local hw=.5*(1-lt); local a=2*math.pi*i/PHI; table.insert(TARGETS,{x=hw*math.cos(a),y=y,z=hw*math.sin(a)*.15}) end

while #TARGETS<500 do table.insert(TARGETS,{x=0,y=60,z=0}) end
if #TARGETS>500 then for i=#TARGETS,501,-1 do TARGETS[i]=nil end end
local function getSlot(i) return TARGETS[((i-1)%500)+1] end

-- ══════════════════════════════════════════════════════════════════════════════
-- ── SWORD ENGINE ─────────────────────────────────────────────────────────────
-- ══════════════════════════════════════════════════════════════════════════════

local MAX_SWORDS=8
local swords={}
local partOwner={}; local partCounter=0; local activeSwordCount=0

local function createSword(idx)
    local sw={}; sw.idx=idx; sw.enabled=false; sw.parts={}
    sw.yaw=0; sw.pitch=0; sw.centerPos=HRP.Position

    sw.folder=Instance.new("Folder",Workspace)
    sw.anchor=Instance.new("Part",sw.folder)
    sw.anchor.Anchored=true; sw.anchor.CanCollide=false
    sw.anchor.Transparency=1; sw.anchor.Size=Vector3.new(1,1,1)
    sw.anchor.Position=HRP.Position

    local TA="S"..idx.."A"; local TP="S"..idx.."P"; local TT="S"..idx.."T"

    sw.eligible=function(p)
        if not p:IsA("BasePart") or p.Anchored then return false end
        if not p:IsDescendantOf(Workspace) then return false end
        for _,s in ipairs(swords) do if p:IsDescendantOf(s.folder) then return false end end
        if LP.Character and p:IsDescendantOf(LP.Character) then return false end
        local a=p.Parent
        while a and a~=Workspace do
            if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return false end
            a=a.Parent
        end
        return true
    end

    sw.force=function(p)
        for _,x in next,p:GetChildren() do
            if x:IsA("BodyAngularVelocity") or x:IsA("BodyForce") or x:IsA("BodyGyro")
            or x:IsA("BodyPosition") or x:IsA("BodyThrust") or x:IsA("BodyVelocity")
            or x:IsA("RocketPropulsion") then x:Destroy() end
        end
        for _,n in ipairs({TA,TP,TT}) do local c=p:FindFirstChild(n); if c then c:Destroy() end end
        p.CanCollide=false
        local att=Instance.new("Attachment",p); att.Name=TA
        local torq=Instance.new("Torque",p); torq.Name=TT
        torq.Torque=Vector3.new(1e9,1e9,1e9); torq.Attachment0=att
        local na=Instance.new("Attachment",sw.anchor)
        local ap=Instance.new("AlignPosition",p); ap.Name=TP
        ap.MaxForce=math.huge; ap.MaxVelocity=math.huge; ap.Responsiveness=2000
        ap.Attachment0=att; ap.Attachment1=na; ap.Parent=p
    end

    sw.clean=function(p)
        if not p or not p.Parent then return end
        for _,n in ipairs({TA,TP,TT}) do local c=p:FindFirstChild(n); if c then c:Destroy() end end
    end

    sw.rot=function(x,y,z)
        local cy,sy=math.cos(sw.yaw),math.sin(sw.yaw)
        local cp,sp=math.cos(sw.pitch),math.sin(sw.pitch)
        local rx=cy*x-sy*z; local rz=sy*x+cy*z
        return rx,cp*y-sp*rz,sp*y+cp*rz
    end

    return sw
end

for i=1,MAX_SWORDS do table.insert(swords,createSword(i)) end

local function resetPartitions()
    for _,sw in ipairs(swords) do
        for _,p in ipairs(sw.parts) do sw.clean(p) end
        sw.parts={}
        for _,ch in ipairs(sw.anchor:GetChildren()) do
            if ch:IsA("Attachment") then ch:Destroy() end
        end
    end
    partOwner={}; partCounter=0
    if activeSwordCount==0 then return end
    local pool={}
    for _,p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("BasePart") and not p.Anchored then
            local skip=false
            for _,sw in ipairs(swords) do if p:IsDescendantOf(sw.folder) then skip=true; break end end
            if not skip and LP.Character and p:IsDescendantOf(LP.Character) then skip=true end
            if not skip then
                local a=p.Parent
                while a and a~=Workspace do
                    if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then skip=true; break end
                    a=a.Parent
                end
            end
            if not skip then table.insert(pool,p) end
        end
    end
    for i,p in ipairs(pool) do
        local assigned=((i-1)%activeSwordCount)+1
        partOwner[p]=assigned; partCounter=i
        local sw=swords[assigned]
        if sw.enabled then
            if getgenv().Network then getgenv().Network.RetainPart(p) end
            sw.force(p); table.insert(sw.parts,p)
        end
    end
end

local function globalAdd(p)
    if activeSwordCount==0 then return end
    if not p:IsA("BasePart") or p.Anchored then return end
    if not p:IsDescendantOf(Workspace) then return end
    for _,sw in ipairs(swords) do if p:IsDescendantOf(sw.folder) then return end end
    if LP.Character and p:IsDescendantOf(LP.Character) then return end
    local a=p.Parent
    while a and a~=Workspace do
        if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return end
        a=a.Parent
    end
    if partOwner[p] then
        local sw=swords[partOwner[p]]
        if sw and sw.enabled and not table.find(sw.parts,p) then sw.force(p); table.insert(sw.parts,p) end
        return
    end
    partCounter=partCounter+1
    local assigned=((partCounter-1)%activeSwordCount)+1
    partOwner[p]=assigned
    local sw=swords[assigned]
    if sw and sw.enabled then
        if getgenv().Network then getgenv().Network.RetainPart(p) end
        sw.force(p); table.insert(sw.parts,p)
    end
end

local function globalRemove(p)
    for _,sw in ipairs(swords) do
        local idx=table.find(sw.parts,p); if idx then table.remove(sw.parts,idx) end
    end
    partOwner[p]=nil
end

Workspace.DescendantAdded:Connect(globalAdd)
Workspace.DescendantRemoving:Connect(globalRemove)
RunService.Stepped:Connect(function()
    for _,p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("BasePart") and not p.Anchored and not partOwner[p] then globalAdd(p) end
    end
end)

-- shape engine
RunService.Heartbeat:Connect(function()
    for _,sw in ipairs(swords) do
        if sw.enabled then
            for i,part in ipairs(sw.parts) do
                if part.Parent and not part.Anchored then
                    local s=getSlot(i)
                    local rx,ry,rz=sw.rot(s.x,s.y,s.z)
                    local target=sw.centerPos+Vector3.new(rx,ry,rz)
                    local dir=target-part.Position
                    if dir.Magnitude>0 then part.Velocity=dir.Unit*999999 end
                end
            end
        end
    end
end)

-- ══════════════════════════════════════════════════════════════════════════════
-- ── HOLLOW PURPLE STATE MACHINE ───────────────────────────────────────────────
--
-- STATES:
--   idle     → swords follow fixed offset positions (L×4 + R×4)
--   charging → clusters converge toward merge point at speed CONFIG.chargeSpeed
--   merged   → ball hovers at merge point, aim joystick active
--   firing   → ball launches in aim direction at CONFIG.fireSpeed
--
-- POSITIONS:
--   LEFT  cluster: 45st left + 9st forward of HRP (×4 swords spread 4st apart)
--   RIGHT cluster: 45st right + 9st forward of HRP (×4 swords spread 4st apart)
--   MERGE point:   9st forward of HRP, center
-- ══════════════════════════════════════════════════════════════════════════════

local STATE = {
    IDLE     = "idle",
    CHARGING = "charging",
    MERGED   = "merged",
    FIRING   = "firing",
}

local CONFIG = {
    SIDE_DIST    = 45,    -- studs left/right
    FRONT_DIST   = 9,     -- studs forward
    SWORD_SPREAD = 4,     -- spacing between swords in same cluster
    CHARGE_SPEED = 8,     -- studs/s convergence speed (adjustable)
    FIRE_SPEED   = 120,   -- studs/s projectile launch speed (adjustable)
    FIRE_DURATION = 3,    -- seconds before fire clears
}

local state       = STATE.IDLE
local chargeT     = 0         -- accumulator for convergence
local fireDir     = Vector3.new(0,0,-1)  -- direction of fire (default forward)
local aimActive   = false     -- thumb joystick being held
local aimDelta    = Vector2.zero
local aimTouch    = nil
local fireTimer   = 0

-- compute the world positions for all 8 swords given current HRP
local function getSwordPositions()
    local cf      = HRP.CFrame
    local fwd     = cf.LookVector
    local right   = cf.RightVector
    local origin  = cf.Position + fwd * CONFIG.FRONT_DIST

    local positions = {}
    -- swords 1-4: LEFT cluster
    for i=1,4 do
        local offset = -right * (CONFIG.SIDE_DIST + (i-1)*CONFIG.SWORD_SPREAD)
        positions[i] = origin + offset
    end
    -- swords 5-8: RIGHT cluster
    for i=1,4 do
        local offset = right * (CONFIG.SIDE_DIST + (i-1)*CONFIG.SWORD_SPREAD)
        positions[i+4] = origin + offset
    end
    return positions
end

-- center merge point 9st forward of HRP
local function getMergePoint()
    return HRP.Position + HRP.CFrame.LookVector * CONFIG.FRONT_DIST
end

-- set all 8 sword center positions to a set of Vector3s
local function setSwordCenters(positions)
    for i=1,8 do
        if swords[i] and swords[i].enabled then
            swords[i].centerPos   = positions[i] or positions[1]
            swords[i].anchor.Position = swords[i].centerPos
        end
    end
end

-- lerp all swords toward merge point
local function convergeSwords(dt)
    local merge   = getMergePoint()
    local speed   = CONFIG.CHARGE_SPEED * dt
    local allDone = true

    for i=1,8 do
        local sw=swords[i]
        if sw.enabled then
            local diff = merge - sw.centerPos
            local dist = diff.Magnitude
            if dist > 0.5 then
                allDone = false
                sw.centerPos   = sw.centerPos + diff.Unit * math.min(speed, dist)
            else
                sw.centerPos   = merge
            end
            sw.anchor.Position = sw.centerPos
        end
    end

    return allDone
end

-- launch: set velocity of all parts directly toward fireDir
local function launchParts()
    for _,sw in ipairs(swords) do
        for _,p in ipairs(sw.parts) do
            if p and p.Parent then
                -- remove AlignPosition so parts fly free
                for _,ch in ipairs(p:GetChildren()) do
                    if ch:IsA("AlignPosition") or ch:IsA("Torque") or ch:IsA("Attachment") then
                        ch:Destroy()
                    end
                end
                pcall(function()
                    p.Velocity = fireDir * CONFIG.FIRE_SPEED
                end)
            end
        end
        -- clear part list so engine doesn't re-constrain them
        sw.parts={}
    end
    partOwner={}; partCounter=0
end

-- reset everything back to idle
local function resetToIdle()
    state = STATE.IDLE
    chargeT = 0
    -- reposition swords to their formation spots
    local positions = getSwordPositions()
    setSwordCenters(positions)
end

-- ── main state machine heartbeat ──────────────────────────────────────────────
RunService.Heartbeat:Connect(function(dt)
    if state == STATE.IDLE then
        -- follow player formation continuously
        if activeSwordCount > 0 then
            local positions = getSwordPositions()
            setSwordCenters(positions)
        end

    elseif state == STATE.CHARGING then
        local done = convergeSwords(dt)
        if done then
            state = STATE.MERGED
            playSound("2865227271")
        end

    elseif state == STATE.MERGED then
        -- hold merge point, update to follow HRP movement
        local merge = getMergePoint()
        for i=1,8 do
            local sw=swords[i]
            if sw.enabled then
                sw.centerPos=merge; sw.anchor.Position=merge
            end
        end

        -- aim direction: use joystick delta to rotate fire direction
        if aimActive then
            local cf     = HRP.CFrame
            local fwd    = Vector3.new(cf.LookVector.X,0,cf.LookVector.Z)
            local rgt    = Vector3.new(cf.RightVector.X,0,cf.RightVector.Z)
            if fwd.Magnitude>0.01 then fwd=fwd.Unit end
            if rgt.Magnitude>0.01 then rgt=rgt.Unit end
            -- joystick X = yaw (horizontal aim), Y = pitch (vertical aim)
            local yawDir   = (rgt * aimDelta.X + fwd * (-aimDelta.Y))
            if yawDir.Magnitude > 0.01 then
                fireDir = Vector3.new(yawDir.X, 0, yawDir.Z).Unit
            end
        end

    elseif state == STATE.FIRING then
        fireTimer = fireTimer - dt
        if fireTimer <= 0 then
            -- clean up and reset
            for _,sw in ipairs(swords) do
                for _,p in ipairs(sw.parts) do
                    if p and p.Parent then pcall(function() p:Destroy() end) end
                end
                sw.parts={}
            end
            partOwner={}; partCounter=0
            state=STATE.IDLE
        end
    end
end)

