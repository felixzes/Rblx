-- ── zone definitions ──────────────────────────────────────────────────────────
local ZONE_NAMES = {
    "tip","falseEdge","cuttingEdge","spine","bladeFlat","fuller",
    "foible","bladeCenter","forte","ricasso","shoulder",
    "guardCenter","crossguard","quillonLeft","quillonRight",
    "langetLeft","langetRight","guardTerminalLeft","guardTerminalRight",
    "tang","tangShoulder","tangEnd","pommelConnection",
    "pommelBody","pommelShoulder","pommelCap",
}

local ZONE_WEIGHTS = {
    tip=3, falseEdge=4, cuttingEdge=6, spine=5, bladeFlat=6, fuller=4,
    foible=5, bladeCenter=5, forte=5, ricasso=4, shoulder=3,
    guardCenter=3, crossguard=4, quillonLeft=4, quillonRight=4,
    langetLeft=2, langetRight=2, guardTerminalLeft=2, guardTerminalRight=2,
    tang=4, tangShoulder=2, tangEnd=2, pommelConnection=2,
    pommelBody=5, pommelShoulder=3, pommelCap=2,
}

local function getZoneLocalPos(name)
    local D = DIM
    if name=="tip"              then return Vector3.new(0, D.bladeLength, 0)
    elseif name=="falseEdge"    then return Vector3.new(0, D.bladeLength*0.80,  D.bladeThickness*0.35)
    elseif name=="cuttingEdge"  then return Vector3.new(0, D.bladeLength*0.55, -D.bladeThickness*0.5)
    elseif name=="spine"        then return Vector3.new(0, D.bladeLength*0.50,  D.bladeThickness*0.5)
    elseif name=="bladeFlat"    then return Vector3.new(D.bladeBaseWidth*0.35, D.bladeLength*0.45, 0)
    elseif name=="fuller"       then return Vector3.new(0, D.bladeLength*0.40, 0)
    elseif name=="foible"       then return Vector3.new(0, D.bladeLength*0.75, 0)
    elseif name=="bladeCenter"  then return Vector3.new(0, D.bladeLength*0.50, 0)
    elseif name=="forte"        then return Vector3.new(0, D.bladeLength*0.18, 0)
    elseif name=="ricasso"      then return Vector3.new(0, D.ricassoLength*0.5, 0)
    elseif name=="shoulder"     then return Vector3.new(0, 2, 0)
    elseif name=="guardCenter"  then return Vector3.new(0, 0, 0)
    elseif name=="crossguard"   then return Vector3.new(0, 0, 0)
    elseif name=="quillonLeft"  then return Vector3.new(-D.quillonLength*0.6, 0, 0)
    elseif name=="quillonRight" then return Vector3.new( D.quillonLength*0.6, 0, 0)
    elseif name=="langetLeft"   then return Vector3.new(-0.8, -2, 0)
    elseif name=="langetRight"  then return Vector3.new( 0.8, -2, 0)
    elseif name=="guardTerminalLeft"  then return Vector3.new(-D.quillonLength, 0, 0)
    elseif name=="guardTerminalRight" then return Vector3.new( D.quillonLength, 0, 0)
    elseif name=="tang"         then return Vector3.new(0, -(D.gripLength*0.5), 0)
    elseif name=="tangShoulder" then return Vector3.new(0, -2, 0)
    elseif name=="tangEnd"      then return Vector3.new(0, -(D.gripLength+1), 0)
    elseif name=="pommelConnection" then return Vector3.new(0, -(D.gripLength+D.pommelHeight*0.15), 0)
    elseif name=="pommelBody"   then return Vector3.new(0, -(D.gripLength+D.pommelHeight*0.5), 0)
    elseif name=="pommelShoulder" then return Vector3.new(0, -(D.gripLength+D.pommelHeight*0.15), 0)
    elseif name=="pommelCap"    then return Vector3.new(0, -(D.gripLength+D.pommelHeight+DIM.pommelCapHeight*0.5), 0)
    end
    return Vector3.new(0,0,0)
end

-- zone slot table (weighted)
local ZONE_SLOTS = (function()
    local t = {}
    for _, name in ipairs(ZONE_NAMES) do
        local w = ZONE_WEIGHTS[name] or 2
        for _ = 1, w do table.insert(t, name) end
    end
    return t
end)()

-- ── sword engine (from Purple) ────────────────────────────────────────────────
local MAX_SWORDS = 8
local swords = {}
local partOwner = {}; local partCounter = 0; local activeSwordCount = 0
local connections = {}

local Folder = Instance.new("Folder", workspace)

local function createSword(idx)
    local sw = {}
    sw.idx       = idx
    sw.enabled   = false
    sw.parts     = {}
    sw.yaw       = 0
    sw.pitch     = 0
    sw.centerPos = HRP.Position

    -- one anchor per zone per sword
    sw.zoneAnchors = {}
    sw.zoneAtts    = {}
    for _, name in ipairs(ZONE_NAMES) do
        local a = Instance.new("Part", Folder)
        a.Anchored=true; a.CanCollide=false; a.Transparency=1
        a.Size=Vector3.new(1,1,1); a.Position=HRP.Position
        local att = Instance.new("Attachment", a)
        sw.zoneAnchors[name] = a
        sw.zoneAtts[name]    = att
    end

    local TA = "SW"..idx.."A"
    local TP = "SW"..idx.."P"

    sw.rot = function(v)
        local cy,sy = math.cos(sw.yaw), math.sin(sw.yaw)
        local cp,sp = math.cos(sw.pitch), math.sin(sw.pitch)
        local rx = cy*v.X - sy*v.Z
        local rz = sy*v.X + cy*v.Z
        return Vector3.new(rx, cp*v.Y - sp*rz, sp*v.Y + cp*rz)
    end

    sw.updateZoneAnchors = function()
        for _, name in ipairs(ZONE_NAMES) do
            local localPos = getZoneLocalPos(name)
            local rotated  = sw.rot(localPos)
            sw.zoneAnchors[name].Position = sw.centerPos + rotated
        end
    end

    sw.force = function(p, zoneName)
        for _, c in ipairs(p:GetChildren()) do
            if c:IsA("BodyVelocity") or c:IsA("BodyGyro")
            or c:IsA("BodyPosition") or c:IsA("BodyAngularVelocity")
            or c:IsA("BodyForce")   or c:IsA("RocketPropulsion")
            or c.Name==TA or c.Name==TP then
                c:Destroy()
            end
        end
        p.CanCollide = false
        pcall(function() p:SetNetworkOwner(LP) end)
        if getgenv().Network then getgenv().Network.RetainPart(p) end

        local att = Instance.new("Attachment", p); att.Name = TA
        local targetAtt = sw.zoneAtts[zoneName] or sw.zoneAtts["bladeCenter"]

        local ap = Instance.new("AlignPosition", p); ap.Name = TP
        ap.MaxForce       = math.huge
        ap.MaxVelocity    = math.huge
        ap.Responsiveness = 200
        ap.RigidityEnabled = true
        ap.Attachment0    = att
        ap.Attachment1    = targetAtt
        ap.Parent         = p
    end

    sw.clean = function(p)
        if not p or not p.Parent then return end
        for _, c in ipairs(p:GetChildren()) do
            if c.Name==TA or c.Name==TP then c:Destroy() end
        end
    end

    sw.eligible = function(p)
        if not p:IsA("BasePart") or p.Anchored then return false end
        if not p:IsDescendantOf(workspace) then return false end
        if p:IsDescendantOf(Folder) then return false end
        if LP.Character and p:IsDescendantOf(LP.Character) then return false end
        local a = p.Parent
        while a and a ~= workspace do
            if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return false end
            a = a.Parent
        end
        return true
    end

    return sw
end

for i = 1, MAX_SWORDS do table.insert(swords, createSword(i)) end

-- zone assignment per part (stored as {swordIdx, zoneName})
local partZone = {}

local function assignZone(globalIdx, swordIdx)
    local zoneSlot = ZONE_SLOTS[((globalIdx - 1) % #ZONE_SLOTS) + 1]
    return zoneSlot
end

local function resetPartitions()
    for _, sw in ipairs(swords) do
        for _, p in ipairs(sw.parts) do sw.clean(p) end
        sw.parts = {}
    end
    partOwner = {}; partZone = {}; partCounter = 0
    if activeSwordCount == 0 then return end

    local pool = {}
    for _, p in ipairs(workspace:GetDescendants()) do
        if p:IsA("BasePart") and not p.Anchored
        and not p:IsDescendantOf(Folder) then
            local skip = false
            if LP.Character and p:IsDescendantOf(LP.Character) then skip = true end
            if not skip then
                local a = p.Parent
                while a and a ~= workspace do
                    if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then skip=true; break end
                    a = a.Parent
                end
            end
            if not skip then table.insert(pool, p) end
        end
    end

    for i, p in ipairs(pool) do
        partCounter = i
        local swordIdx = ((i-1) % activeSwordCount) + 1
        local zoneName = assignZone(i, swordIdx)
        partOwner[p] = swordIdx
        partZone[p]  = zoneName
        local sw = swords[swordIdx]
        if sw.enabled then
            sw.force(p, zoneName)
            table.insert(sw.parts, p)
        end
    end
end

local function globalAdd(p)
    if activeSwordCount == 0 then return end
    if not p:IsA("BasePart") or p.Anchored then return end
    if not p:IsDescendantOf(workspace) or p:IsDescendantOf(Folder) then return end
    if LP.Character and p:IsDescendantOf(LP.Character) then return end
    local a = p.Parent
    while a and a ~= workspace do
        if a:FindFirstChild("Humanoid") or a:FindFirstChild("Head") then return end
        a = a.Parent
    end
    if partOwner[p] then
        local sw = swords[partOwner[p]]
        if sw and sw.enabled and not table.find(sw.parts, p) then
            sw.force(p, partZone[p] or "bladeCenter")
            table.insert(sw.parts, p)
        end
        return
    end
    partCounter = partCounter + 1
    local swordIdx = ((partCounter-1) % activeSwordCount) + 1
    local zoneName = assignZone(partCounter, swordIdx)
    partOwner[p] = swordIdx
    partZone[p]  = zoneName
    local sw = swords[swordIdx]
    if sw and sw.enabled then
        sw.force(p, zoneName)
        table.insert(sw.parts, p)
    end
end

local function globalRemove(p)
    for _, sw in ipairs(swords) do
        local idx = table.find(sw.parts, p)
        if idx then table.remove(sw.parts, idx) end
    end
    partOwner[p] = nil; partZone[p] = nil
end

local descAdded = workspace.DescendantAdded:Connect(function(p)
    task.defer(function() globalAdd(p) end)
end)
local descRem = workspace.DescendantRemoving:Connect(globalRemove)
table.insert(connections, descAdded)
table.insert(connections, descRem)

local sweepConn = RunService.Stepped:Connect(function()
    for _, p in ipairs(workspace:GetDescendants()) do
        if p:IsA("BasePart") and not p.Anchored and not partOwner[p] then
