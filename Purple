    dec.BorderSizePixel=0; dec.Text="−"; dec.TextColor3=Color3.fromRGB(255,255,255)
    dec.TextSize=18; dec.Font=Enum.Font.GothamBold; dec.ZIndex=12; dec.Parent=row
    Instance.new("UICorner",dec).CornerRadius=UDim.new(0,6)

    local disp=Instance.new("TextLabel"); disp.Size=UDim2.new(1,-76,1,-6)
    disp.Position=UDim2.new(0,38,0,3); disp.BackgroundColor3=Color3.fromRGB(24,10,40)
    disp.TextColor3=Color3.fromRGB(220,180,255); disp.TextSize=14; disp.Font=Enum.Font.GothamBold
    disp.Text=tostring(getVal()); disp.BorderSizePixel=0; disp.ZIndex=12; disp.Parent=row
    Instance.new("UICorner",disp).CornerRadius=UDim.new(0,6)

    local inc=Instance.new("TextButton"); inc.Size=UDim2.new(0,32,1,-6)
    inc.Position=UDim2.new(1,-35,0,3); inc.BackgroundColor3=Color3.fromRGB(120,0,200)
