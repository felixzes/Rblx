local TARGETS={}
local PHI=(1+math.sqrt(5))/2

local function ring(i,n,r,fz) local a=2*math.pi*(i-1)/n; return r*math.cos(a),r*math.sin(a)*(fz or 1) end
local function sun(i,n,R,fz) local r=R*math.sqrt(i/n); local a=2*math.pi*i/(PHI*PHI); return r*math.cos(a),r*math.sin(a)*(fz or 1) end
local function b3(t,p0,p1,p2,p3) local u=1-t; return u^3*p0+3*u^2*t*p1+3*u*t^2*p2+t^3*p3 end
local function jt(i,s) return ((i*1619+s*1013)%1000)/500-1 end

for i=1,24 do local x,z=ring(i,24,10.5,.30); table.insert(TARGETS,{x=x,y=-57+(i%4)*.6,z=z}) end
for i=1,18 do local x,z=ring(i,18,7.0,.30); table.insert(TARGETS,{x=x,y=-56+(i%3)*.7,z=z}) end
