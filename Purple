for i=1,22 do local t=(i-1)/21; local th=(1-t)*3.8+.5; table.insert(TARGETS,{x=b3(t,-11,-20,-25,-24)+jt(i,3)*th*.4,y=b3(t,-40,-39,-37,-34),z=jt(i,2)*th*.5}) end
for i=1,22 do local t=(i-1)/21; local th=(1-t)*3.8+.5; table.insert(TARGETS,{x=b3(t,11,20,25,24)+jt(i,5)*th*.4,y=b3(t,-40,-39,-37,-34),z=jt(i,4)*th*.5}) end
for i=1,8  do local a=2*math.pi*(i-1)/8; table.insert(TARGETS,{x=-24+math.cos(a)*2.8,y=-34+math.sin(a)*2.2,z=jt(i,6)*.9}) end
for i=1,8  do local a=2*math.pi*(i-1)/8; table.insert(TARGETS,{x= 24+math.cos(a)*2.8,y=-34+math.sin(a)*2.2,z=jt(i,7)*.9}) end
for i=1,10 do local lt=(i-1)/9; local th=(1-lt)*2.8+.3; table.insert(TARGETS,{x=b3(lt,-9,-14,-16,-13),y=b3(lt,-40,-43,-47,-49),z=jt(i,8)*th*.4}) end
for i=1,10 do local lt=(i-1)/9; local th=(1-lt)*2.8+.3; table.insert(TARGETS,{x=b3(lt,9,14,16,13),y=b3(lt,-40,-43,-47,-49),z=jt(i,9)*th*.4}) end
for i=1,4  do local lt=(i-1)/3; table.insert(TARGETS,{x=-3.6,y=-38-lt*6,z=jt(i,10)*.3}) end
for i=1,4  do local lt=(i-1)/3; table.insert(TARGETS,{x= 3.6,y=-38-lt*6,z=jt(i,11)*.3}) end

local BROOT=-14; local BTIP=60; local BMW=13.5; local BMD=2.2
local function bp(y)
    if y<=BROOT then return BMW,BMD end
    if y>=BTIP  then return 0,0 end
    local be=54
    if y<=be then
        local t=(y-BROOT)/(be-BROOT)
        return math.max(0,BMW*(1-t^1.6)),math.max(0,BMD*(1-t^1.3))
    end
    local t=(y-be)/(BTIP-be); return BMW*(1-t)*.08,BMD*(1-t)*.18
end

for i=1,16 do local lt=(i-1)/15; local y=-22+lt*8; local hw,hd=bp(y); local a=2*math.pi*i/PHI; local r=math.sqrt((i-.5)/16); table.insert(TARGETS,{x=r*hw*math.cos(a),y=y,z=r*hd*math.sin(a)}) end
for i=1,8  do local a=2*math.pi*(i-1)/8; local hw,hd=bp(-14); table.insert(TARGETS,{x=hw*math.cos(a),y=-14+(i%3)*.4,z=hd*math.sin(a)}) end
