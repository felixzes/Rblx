    inc.TextSize=18; inc.Font=Enum.Font.GothamBold; inc.ZIndex=12; inc.Parent=row
    Instance.new("UICorner",inc).CornerRadius=UDim.new(0,6)

    dec.MouseButton1Click:Connect(function() onDec(); disp.Text=tostring(getVal()) end)
    inc.MouseButton1Click:Connect(function() onInc(); disp.Text=tostring(getVal()) end)
    return disp
end

