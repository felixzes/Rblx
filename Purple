-- ── state machine (from Purple) ───────────────────────────────────────────────
local STATE = { IDLE="idle", CHARGING="charging", MERGED="merged", FIRING="firing" }
local state     = STATE.IDLE
local fireDir   = Vector3.new(0,0,-1)
local aimActive = false
local aimDelta  = Vector2.zero
local aimTouch  = nil
local fireTimer = 0

local CONFIG = {
    SIDE_DIST    = 45,
    FRONT_DIST   = 9,
    SWORD_SPREAD = 4,
    CHARGE_SPEED = 8,
    FIRE_SPEED   = 120,
    FIRE_DURATION= 3,
}

local function getSwordPositions()
    local cf     = HRP.CFrame
    local fwd    = cf.LookVector
    local right  = cf.RightVector
    local origin = cf.Position + fwd * CONFIG.FRONT_DIST
    local pos    = {}
    for i = 1,4 do
        pos[i]   = origin + (-right) * (CONFIG.SIDE_DIST + (i-1)*CONFIG.SWORD_SPREAD)
    end
    for i = 1,4 do
        pos[i+4] = origin + right * (CONFIG.SIDE_DIST + (i-1)*CONFIG.SWORD_SPREAD)
    end
    return pos
end

local function getMergePoint()
    return HRP.Position + HRP.CFrame.LookVector * CONFIG.FRONT_DIST
end

local function setSwordCenters(positions)
    for i = 1, 8 do
        if swords[i] and swords[i].enabled then
            swords[i].centerPos = positions[i] or positions[1]
        end
    end
end

local function convergeSwords(dt)
    local merge   = getMergePoint()
    local speed   = CONFIG.CHARGE_SPEED * dt
    local allDone = true
    for i = 1, 8 do
        local sw = swords[i]
        if sw.enabled then
            local diff = merge - sw.centerPos
            local dist = diff.Magnitude
            if dist > 0.5 then
                allDone = false
                sw.centerPos = sw.centerPos + diff.Unit * math.min(speed, dist)
            else
                sw.centerPos = merge
            end
        end
    end
    return allDone
end

local function launchParts()
    for _, sw in ipairs(swords) do
        for _, p in ipairs(sw.parts) do
            if p and p.Parent then
                for _, c in ipairs(p:GetChildren()) do
                    if c:IsA("AlignPosition") or c:IsA("Attachment") then c:Destroy() end
                end
                local bv = Instance.new("BodyVelocity")
                bv.Name     = "SWBlast"
                bv.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
                bv.Velocity = fireDir * CONFIG.FIRE_SPEED
                bv.P        = 1e9
                bv.Parent   = p
                task.delay(0.25, function()
                    if bv and bv.Parent then bv:Destroy() end
                end)
            end
        end
        sw.parts = {}
    end
    partOwner = {}; partZone = {}; partCounter = 0
end

local function resetToIdle()
    state = STATE.IDLE
    local positions = getSwordPositions()
    setSwordCenters(positions)
end

-- main heartbeat: follow + zone anchor update + state machine
local mainConn = RunService.Heartbeat:Connect(function(dt)
    -- always update zone anchors so they track sword center + rotation
    for _, sw in ipairs(swords) do
        if sw.enabled then sw.updateZoneAnchors() end
    end

    if state == STATE.IDLE then
        if activeSwordCount > 0 then
            local positions = getSwordPositions()
            setSwordCenters(positions)
        end

    elseif state == STATE.CHARGING then
        local done = convergeSwords(dt)
        if done then
            state = STATE.MERGED
            playSound("2865227271")
        end

    elseif state == STATE.MERGED then
        local merge = getMergePoint()
        for i = 1, 8 do
            if swords[i].enabled then
                swords[i].centerPos = merge
            end
        end
        if aimActive then
            local cf  = HRP.CFrame
            local fwd = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
            local rgt = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
            if fwd.Magnitude>0.01 then fwd=fwd.Unit end
            if rgt.Magnitude>0.01 then rgt=rgt.Unit end
            local d = rgt*aimDelta.X + fwd*(-aimDelta.Y)
            if d.Magnitude>0.01 then fireDir = d.Unit end
        end

    elseif state == STATE.FIRING then
        fireTimer = fireTimer - dt
        if fireTimer <= 0 then
            state = STATE.IDLE
            if activeSwordCount > 0 then
                resetPartitions()
                resetToIdle()
            end
        end
    end
end)
table.insert(connections, mainConn)

