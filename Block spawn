titleL.ZIndex=3; titleL.Parent=bar

local drag,ds,sp=false,Vector2.zero,UDim2.new()
bar.InputBegan:Connect(function(i)
    if i.UserInputType~=Enum.UserInputType.MouseButton1
    and i.UserInputType~=Enum.UserInputType.Touch then return end
    drag=true; ds=Vector2.new(i.Position.X,i.Position.Y); sp=panel.Position
    i.Changed:Connect(function()
        if i.UserInputState==Enum.UserInputState.End then drag=false end
    end)
end)
UserInputService.InputChanged:Connect(function(i)
    if not drag then return end
    if i.UserInputType~=Enum.UserInputType.MouseMovement
    and i.UserInputType~=Enum.UserInputType.Touch then return end
    local d=Vector2.new(i.Position.X,i.Position.Y)-ds
    panel.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
end)

-- helper fns
local function lbl(txt,y,col,sz)
    local L=Instance.new("TextLabel")
    L.Size=UDim2.new(1,-16,0,13); L.Position=UDim2.new(0,8,0,y)
    L.BackgroundTransparency=1; L.Text=txt
    L.TextColor3=col or Color3.fromRGB(100,110,160); L.TextSize=sz or 10
    L.Font=Enum.Font.Gotham; L.TextXAlignment=Enum.TextXAlignment.Left
    L.ZIndex=3; L.Parent=panel; return L
end
local function mkBtn(txt,y,h,col)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(1,-16,0,h or 32); b.Position=UDim2.new(0,8,0,y)
    b.BackgroundColor3=col or Color3.fromRGB(30,30,140); b.BorderSizePixel=0
    b.Text=txt; b.TextColor3=Color3.fromRGB(255,255,255)
    b.TextSize=12; b.Font=Enum.Font.GothamBold; b.ZIndex=3; b.Parent=panel
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,10)
    return b
end
local function mkStepper(y,lbl2,getV,onDec,onInc)
    lbl(lbl2,y)
    local function sb(txt,x)
        local b=Instance.new("TextButton")
        b.Size=UDim2.new(0.22,0,0,26); b.Position=UDim2.new(x,0,0,y+14)
        b.BackgroundColor3=Color3.fromRGB(30,32,50); b.BorderSizePixel=0
        b.Text=txt; b.TextColor3=Color3.fromRGB(255,255,255)
        b.TextSize=14; b.Font=Enum.Font.GothamBold; b.ZIndex=3; b.Parent=panel
        Instance.new("UICorner",b).CornerRadius=UDim.new(0,7)
        return b
    end
    local dec=sb("−",0.08)
    local disp=Instance.new("TextLabel")
    disp.Size=UDim2.new(0.42,0,0,26); disp.Position=UDim2.new(0.3,0,0,y+14)
    disp.BackgroundColor3=Color3.fromRGB(14,16,28); disp.BorderSizePixel=0
    disp.Text=getV(); disp.TextColor3=Color3.fromRGB(200,210,255)
    disp.TextSize=12; disp.Font=Enum.Font.GothamBold; disp.ZIndex=3; disp.Parent=panel
    Instance.new("UICorner",disp).CornerRadius=UDim.new(0,7)
    local inc=sb("+",0.72)
    dec.MouseButton1Click:Connect(function() onDec(); disp.Text=getV() end)
    inc.MouseButton1Click:Connect(function() onInc(); disp.Text=getV() end)
    return disp
end

