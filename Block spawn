--[[
    ServerParts.lua — 10 adjustable server-side parts
    executor script (Synapse X, KRNL, Fluxus, Solara, etc.)

    HOW IT REPLICATES:
    - ReplicationFocus = Workspace → tells server this client simulates everything
    - sethiddenproperty SimulationRadius → max physics ownership radius
    - Parts are ANCHORED → zero physics cost, zero lag
    - CFrame is set each Heartbeat → replicates position to server + all clients
    - Massless + CanCollide false → no collision overhead

    result: parts are visible and positioned to everyone, no server script needed
]]

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace        = game:GetService("Workspace")
local LocalPlayer      = Players.LocalPlayer

-- ─── CLAIM MAX SIMULATION RADIUS ─────────────────────
-- this is the core replication trick — client tells server
-- it owns physics for a huge radius, so parts it touches
-- get replicated back to the server and all other clients
LocalPlayer.ReplicationFocus = Workspace
RunService.Heartbeat:Connect(function()
    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius",    2147483647)
        sethiddenproperty(LocalPlayer, "MaxSimulationRadius", 2147483647)
    end)
end)

-- ─── CONFIG ───────────────────────────────────────────
local PART_COUNT  = 10
local PART_SIZE   = Vector3.new(4, 4, 4)
local PART_MAT    = Enum.Material.SmoothPlastic
local ORBIT_RADIUS  = 8      -- studs from player
local ORBIT_HEIGHT  = 3      -- Y offset above HRP
local ORBIT_SPEED   = 1.2    -- radians per second
local COLORS = {
    Color3.fromRGB(220, 50,  50),
    Color3.fromRGB(220,130,  40),
    Color3.fromRGB(220,220,  40),
    Color3.fromRGB( 50,200,  80),
    Color3.fromRGB( 40,160, 220),
    Color3.fromRGB(120,  50, 220),
    Color3.fromRGB(220,  60, 160),
    Color3.fromRGB(255, 255, 255),
    Color3.fromRGB( 80, 220, 220),
    Color3.fromRGB(255, 140,   0),
}

-- ─── FOLDER ───────────────────────────────────────────
local folder = Instance.new("Folder")
folder.Name  = "ServerParts"
folder.Parent = Workspace

-- ─── SPAWN PARTS ─────────────────────────────────────
-- ANCHORED = true is the key — anchored parts use no physics
-- simulation so they produce zero lag regardless of count.
-- position is set via CFrame each frame which does replicate.

local parts = {}

for i = 1, PART_COUNT do
    local p = Instance.new("Part")
    p.Name         = "SP_" .. i
    p.Size         = PART_SIZE
    p.Anchored     = true           -- zero physics cost
    p.CanCollide   = false          -- no collision overhead
    p.CastShadow   = false          -- no shadow overhead
    p.Massless     = true
    p.Material     = PART_MAT
    p.Color        = COLORS[i] or Color3.fromRGB(255,255,255)
    p.TopSurface   = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent       = folder         -- parent to workspace folder → replicates
    table.insert(parts, p)
end

-- ─── ORBIT LOOP ──────────────────────────────────────
-- drives CFrame every Heartbeat — anchored part CFrame writes
-- replicate to the server and all clients (this is the behavior
-- the SimulationRadius trick enables).
-- using RunService.Heartbeat NOT RenderStepped so it runs
-- even when tab is unfocused.

local t = 0
local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local hrp  = char:WaitForChild("HumanoidRootPart")

LocalPlayer.CharacterAdded:Connect(function(c)
    char = c
    hrp  = c:WaitForChild("HumanoidRootPart")
end)

RunService.Heartbeat:Connect(function(dt)
    if not hrp or not hrp.Parent then return end
    t = t + dt * ORBIT_SPEED

    local center = hrp.Position + Vector3.new(0, ORBIT_HEIGHT, 0)

    for i, p in ipairs(parts) do
        if not p or not p.Parent then continue end

        -- evenly spaced around a circle + stagger height with sine
        local angle  = t + (2 * math.pi * (i - 1) / PART_COUNT)
        local hBob   = math.sin(t * 1.5 + i) * 1.2   -- gentle up/down bob

        local pos = Vector3.new(
            center.X + ORBIT_RADIUS * math.cos(angle),
            center.Y + hBob,
            center.Z + ORBIT_RADIUS * math.sin(angle)
        )

        -- CFrame.new(position, lookAt) makes part face the player
        p.CFrame = CFrame.new(pos, Vector3.new(center.X, pos.Y, center.Z))
    end
end)

