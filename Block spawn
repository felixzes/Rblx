-- material picker
local MATS = {
    Enum.Material.SmoothPlastic, Enum.Material.Neon,
    Enum.Material.Metal,         Enum.Material.Glass,
    Enum.Material.Ice,           Enum.Material.ForceField,
}
local MAT_NAMES = {"Plastic","Neon","Metal","Glass","Ice","ForceField"}
local matIdx = 1
lbl("material",270)
local matLeft  = Instance.new("TextButton")
matLeft.Size=UDim2.new(0.12,0,0,26); matLeft.Position=UDim2.new(0.08,0,0,284)
matLeft.BackgroundColor3=Color3.fromRGB(30,32,50); matLeft.BorderSizePixel=0
matLeft.Text="<"; matLeft.TextColor3=Color3.fromRGB(255,255,255)
matLeft.TextSize=13; matLeft.Font=Enum.Font.GothamBold; matLeft.ZIndex=3; matLeft.Parent=panel
Instance.new("UICorner",matLeft).CornerRadius=UDim.new(0,7)
local matDisp=Instance.new("TextLabel")
matDisp.Size=UDim2.new(0.6,0,0,26); matDisp.Position=UDim2.new(0.2,0,0,284)
matDisp.BackgroundColor3=Color3.fromRGB(14,16,28); matDisp.BorderSizePixel=0
matDisp.Text=MAT_NAMES[1]; matDisp.TextColor3=Color3.fromRGB(200,210,255)
matDisp.TextSize=11; matDisp.Font=Enum.Font.GothamBold; matDisp.ZIndex=3; matDisp.Parent=panel
Instance.new("UICorner",matDisp).CornerRadius=UDim.new(0,7)
local matRight = Instance.new("TextButton")
matRight.Size=UDim2.new(0.12,0,0,26); matRight.Position=UDim2.new(0.8,0,0,284)
matRight.BackgroundColor3=Color3.fromRGB(30,32,50); matRight.BorderSizePixel=0
matRight.Text=">"; matRight.TextColor3=Color3.fromRGB(255,255,255)
matRight.TextSize=13; matRight.Font=Enum.Font.GothamBold; matRight.ZIndex=3; matRight.Parent=panel
Instance.new("UICorner",matRight).CornerRadius=UDim.new(0,7)
local function applyMat()
    local m=MATS[matIdx]
    for _,p in ipairs(parts) do p.Material=m end
    matDisp.Text=MAT_NAMES[matIdx]
end
matLeft.MouseButton1Click:Connect(function() matIdx=((matIdx-2)%#MATS)+1; applyMat() end)
matRight.MouseButton1Click:Connect(function() matIdx=(matIdx%#MATS)+1;     applyMat() end)

-- hide/show + destroy
local visible = true
local hideBtn = mkBtn("Hide Parts",318,28,Color3.fromRGB(40,40,120))
hideBtn.MouseButton1Click:Connect(function()
    visible = not visible
    for i,p in ipairs(parts) do
        if i <= PART_COUNT then p.Transparency = visible and 0 or 1 end
    end
    hideBtn.Text = visible and "Hide Parts" or "Show Parts"
    hideBtn.BackgroundColor3 = visible and Color3.fromRGB(40,40,120) or Color3.fromRGB(0,100,60)
end)

-- live counter
RunService.Heartbeat:Connect(function()
    local active = 0
    for i,p in ipairs(parts) do if i<=PART_COUNT and p.Transparency==0 then active=active+1 end end
    statusLbl.Text = string.format("● %d parts active — server side", active)
end)
