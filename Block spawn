    function()
        PART_COUNT=math.max(1,PART_COUNT-1)
        for i,p in ipairs(parts) do p.Transparency=(i>PART_COUNT and 1 or 0) end
    end,
    function()
        PART_COUNT=math.min(10,PART_COUNT+1)
        for i,p in ipairs(parts) do p.Transparency=(i>PART_COUNT and 1 or 0) end
    end
)

